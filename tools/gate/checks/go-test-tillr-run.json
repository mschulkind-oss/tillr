{
  "id": "go-test-tillr-run",
  "label": "tools/tillr-run's whole Go suite passes",
  "command": [
    "sh",
    "-c",
    "CGO_ENABLED=0 go run -C tools/tillr-gate . shards tools/tillr-run -k 6 --cache --timeout 0"
  ],
  "scope": "tree",
  "tier": "heavy",
  "timeout_ms": 3600000,
  "reads": [
    "tools/gate/checks/go-test-tillr-run.json",
    "tools/gate/go-test-edges.json",
    "tools/go-test-durations.json",
    "tools/tillr-gate/",
    "tools/tillr-run/",
    "tools/tillr/",
    ".tillr.toml",
    "tools/gate/disabled-tests.json"
  ],
  "tools": [
    "sh",
    "go",
    "git",
    "python3"
  ]
}
