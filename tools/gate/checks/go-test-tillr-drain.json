{
  "id": "go-test-tillr-drain",
  "label": "tools/tillr-drain's whole Go suite passes",
  "command": [
    "sh",
    "-c",
    "CGO_ENABLED=0 python3 tools/go-test-shards.py tools/tillr-drain -k 6 --cache --timeout 0"
  ],
  "scope": "tree",
  "tier": "heavy",
  "timeout_ms": 3600000,
  "reads": [
    "config/tillr/backend-policy.json",
    "config/tillr/commands.json",
    "config/tillr/deny-list.json",
    "config/tillr/gate-policy.json",
    "config/tillr/plan-guidance.md",
    "config/tillr/workflows/",
    "tools/gate/checks/go-test-tillr-drain.json",
    "tools/gate/go-test-edges.json",
    "tools/gate/go_affected.py",
    "tools/go-test-durations.json",
    "tools/go-test-shards.py",
    "tools/pack-mirror-links.py",
    "tools/tillr-cli/",
    "tools/tillr-drain/",
    "tools/tillr-gate/",
    "tools/tillr-item/",
    "tools/tillr-land/",
    "tools/tillr-loop/",
    "tools/tillr-roll/",
    "tools/tillr-run/",
    "tools/tillr-store/",
    "tools/tillr-view/",
    "tools/tillr/",
    "yolo-packs/tillr/pack.json",
    "yolo-packs/tillr/programs/"
  ],
  "tools": [
    "sh",
    "go",
    "git",
    "python3"
  ]
}
