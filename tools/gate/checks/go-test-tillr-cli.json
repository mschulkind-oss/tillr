{
  "id": "go-test-tillr-cli",
  "label": "tools/tillr-cli's whole Go suite passes",
  "command": [
    "sh",
    "-c",
    "cd tools/tillr-cli && CGO_ENABLED=0 GOFLAGS=-trimpath go test -parallel 1 -timeout 0 ./..."
  ],
  "scope": "tree",
  "tier": "heavy",
  "timeout_ms": 3600000,
  "reads": [
    "tools/gate/checks/go-test-tillr-cli.json",
    "tools/tillr-cli/",
    "tools/tillr-drain/",
    "tools/tillr-item/",
    "tools/tillr-land/",
    "tools/tillr-loop/",
    "tools/tillr-roll/",
    "tools/tillr-run/",
    "tools/tillr/"
  ],
  "tools": [
    "sh",
    "go",
    "git"
  ]
}
