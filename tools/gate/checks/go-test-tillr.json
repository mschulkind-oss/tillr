{
  "id": "go-test-tillr",
  "label": "tools/tillr's whole Go suite passes",
  "command": [
    "sh",
    "-c",
    "cd tools/tillr && CGO_ENABLED=0 GOFLAGS=-trimpath go test -parallel 1 -timeout 0 ./..."
  ],
  "scope": "tree",
  "tier": "heavy",
  "timeout_ms": 3600000,
  "reads": [
    "tools/gate/checks/go-test-tillr.json",
    "tools/tillr/",
    "tools/tillr-watch/rules/",
    ".tillr.toml",
    "tools/gate/disabled-tests.json"
  ],
  "tools": [
    "sh",
    "go",
    "git"
  ]
}
