{
  "id": "go-module-inventory",
  "label": "Every per-module Go inventory check passes when a tools/ go.mod is added or removed",
  "command": [
    "tools/gate/repo-gate",
    "go-module-inventory"
  ],
  "scope": "change",
  "tier": "heavy",
  "timeout_ms": 120000,
  "reads": [
    "tools/",
    "tests/tillr-testmain_test.go",
    "tests/tillr_scratch_test.go"
  ],
  "tools": [
    "git",
    "go"
  ],
  "remember": false
}
