{
  "id": "go-affected",
  "label": "Go test packages affected by the change pass",
  "command": [
    "sh",
    "-c",
    "exec go run -C tools/tillr-gate . go-affected --root \"$PWD\" --base \"$1\" --head \"$2\"",
    "go-affected"
  ],
  "scope": "change",
  "tier": "heavy",
  "timeout_ms": 3600000,
  "reads": [
    "config/tillr/backend-policy.json",
    "config/tillr/brief-template.md",
    "config/tillr/commands.json",
    "config/tillr/deny-list.json",
    "config/tillr/gate-policy.json",
    "config/tillr/plan-guidance.md",
    "config/tillr/workflows/",
    "tools/gate/checks/",
    "tools/gate/checks/go-affected.json",
    "tools/gate/go-test-edges.json",
    "tools/go-test-durations.json",
    "tools/tillr-cli/",
    "tools/tillr-drain/",
    "tools/tillr-gate/",
    "tools/tillr-item/",
    "tools/tillr-land/",
    "tools/tillr-loop/",
    "tools/tillr-loop/drain-argv.json",
    "tools/tillr-roll/",
    "tools/tillr-run/",
    "tools/tillr-run/backends/",
    "tools/tillr-store/",
    "tools/tillr-trace/",
    "tools/tillr-view/",
    "tools/tillr-watch/",
    "tools/tillr/",
    "tools/tillr/examples/",
    "tools/tillr/watch/testdata/",
    "yolo-packs/tillr/pack.json",
    "yolo-packs/tillr/programs/"
  ],
  "tools": [
    "sh",
    "go",
    "git"
  ],
  "remember": false
}
