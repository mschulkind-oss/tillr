  "label": "Tracked workflow definitions",
  "command": [
    "tools/gate/repo-gate",
    "workflows"
  ],
  "scope": "change",
  "tier": "heavy",
  "timeout_ms": 20000,
  "reads": [
    "definition.json",
    "config/tillr/",
    "config/tillr/workflows/",
