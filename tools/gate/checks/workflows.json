    "tools/tillr-loop/",
    "tools/tillr-roll/",
    "tools/tillr-watch/",
    "tools/tillr-watch/rules/",
    "tools/tillr/",
    "tools/tillr-item/",
    "tools/tillr-run/",
    "tools/tillr-land/",
    "tools/gate/workflows.go",
    "tools/gate/change_common.go",
    "tools/gate/main.go",
    "tools/gate/repo-gate"
  ],
  "tools": [
    "go",
    "git",
    "python3"
  ],
  "remember": false
}
