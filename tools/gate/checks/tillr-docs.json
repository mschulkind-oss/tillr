{
  "id": "tillr-docs",
  "label": "every face the tillr documents name answers --help, and the build and scratch suites pass",
  "command": [
    "sh",
    "-c",
    "python3 tests/tillr-docs.test.py && python3 tests/tillr-build.test.py && python3 tests/tillr-scratch.test.py"
  ],
  "scope": "tree",
  "tier": "heavy",
  "timeout_ms": 600000,
  "reads": [
    ".justfile",
    "AGENTS.md",
    "README.md",
    "docs/",
    "tests/tillr-build.test.py",
    "tests/tillr-docs.test.py",
    "tests/tillr-scratch.test.py",
    "tests/tillr-testmain_test.go",
    "tools/gate/checks/tillr-docs.json",
    "tools/pack-docs.py",
    "tools/tillr-cli/",
    "tools/tillr-drain/",
    "tools/tillr-loop/",
    "tools/tillr-gate/",
    "tools/tillr-item/",
    "tools/tillr-land/",
    "tools/tillr-roll/",
    "tools/tillr-run/",
    "tools/tillr-store/",
    "tools/tillr-trace/",
    "tools/tillr-view/",
    "tools/tillr/",
    "yolo-packs/tillr/",
    "yolo-packs/tillr/files/local/share/tillr/",
    "yolo-packs/tillr/skills/tillr-operating/"
  ],
  "tools": [
    "sh",
    "python3",
    "git",
    "go",
    "just"
  ]
}
