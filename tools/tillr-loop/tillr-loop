}


def add_candidate_flags(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--item", required=True, help="the item the candidate is for")
    parser.add_argument("--lane", default="", help="the lane the candidate was made in")
    parser.add_argument("--run", required=True, help="the run that produced the candidate")
    parser.add_argument("--worktree", required=True, help="the candidate worktree")
    parser.add_argument("--base", required=True, help="the base sha the candidate is on")
    parser.add_argument("--head", required=True, help="the candidate's head sha")


def add_common_flags(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--root", default=None, help="the repository (default: this checkout)")
    parser.add_argument("--store", default=None, help="the store (default: <root>/.tillr/state.db)")
    parser.add_argument("--work-dir", default=None, help="the loop's scratch (default: <root>/.tillr/loop)")
    parser.add_argument("--now", default=None, help="the clock, RFC 3339 (default: now)")


def add_binary_flags(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--tillr-gate", default="tillr-gate", help="the tillr-gate program")
    parser.add_argument("--tillr-land", default="tillr-land", help="the tillr-land program")
    parser.add_argument("--tillr-item", default="tillr-item", help="the tillr-item program")


def parser_for(kind: str) -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=f"tillr-loop {kind}", allow_abbrev=False)
    parser.add_argument("--check-argv", action="store_true",
                        help="parse arguments only; tillr-step-argv-check-v1 (see drain README)")
    add_candidate_flags(parser)
    add_common_flags(parser)
    add_binary_flags(parser)
    if kind in ("gate", "self-check"):
        parser.add_argument("--registry", default=None,
                            help="the check registry tillr-gate plan reads (default: "
                                 f"${REGISTRY_ENV}, else a registry exported into the run's scratch)")
        parser.add_argument("--gate-program", default=None,
                            help="the program `tillr-gate run --gate` runs (default: "
                                 f"{DEFAULT_GATE_PROGRAM})")
        # A trunk fixer's full gate: the drain's `--fixer-gate` replaces `{green}` with one of
        # these. They widen the default program's remaining checks to the untiered range
        # since the last green trunk, or the whole tree when there is none.
        full = parser.add_mutually_exclusive_group()
        full.add_argument("--since", default=None, metavar="SHA",
                          help="judge the untiered range since SHA, the fixer's last green trunk")
        full.add_argument("--all", action="store_true",
                          help="judge the whole tree untiered: a fixer with no green trunk behind it")
    if kind in ("land", "self-check"):
        parser.add_argument("--base-ref", default=None, help="the branch the base sha is on")
        parser.add_argument("--message-from", default=None,
                            help="the commit in base..head whose message and author date to land")
        parser.add_argument("--observed-trunk", default=None, metavar="SHA",
                            help="the loop's last observed trunk tip, handed to `tillr-land pass`, "
                                 "which refuses with trunk-rewritten if the trunk no longer contains it")
    if kind == "verdict":
        # Required: the verdict is the loop's judgment, so a missing one is refused rather
        # than defaulted to a pass.
        parser.add_argument("--verdict", required=True, choices=("pass", "fail"),
                            help="the verdict to record")
    elif kind == "self-check":
        parser.add_argument("--verdict", default="pass", choices=("pass", "fail"),
                            help="the verdict to show (default: pass)")
    return parser


def gate_program(args: argparse.Namespace) -> str | None:
    """The program `tillr-gate run --gate` executes: the caller's, or this tree's gate.

    Only the gate face has one. The default is built from the candidate's base sha, which
    is the range the change record states, so the plan and the judgment cover one diff.
    """
    if not hasattr(args, "gate_program"):
        return None
    full = ["--since", args.since] if args.since else (["--all"] if args.all else [])
    if args.gate_program:
        if full:
            # A named program receives none of the adapter's own range words, so accepting
            # the range would judge a narrower change than the caller asked for.
            raise Refusal(
                EXIT_USAGE,
                f"{full[0]} widens the default gate program, and --gate-program names "
                "another one: name the range inside that program instead",
            )
        return args.gate_program
    root = resolve_root(args.root, args.worktree)
    logs = Path(args.work_dir or str(Path(root) / ".tillr" / "loop")) / args.run / "change-logs"
    program = DEFAULT_GATE_PROGRAM.format(
        base=shlex.quote(args.base), head=shlex.quote(args.head),
        runner=shlex.quote(args.tillr_gate), logs=shlex.quote(str(logs)))
    return " ".join([program, *(shlex.quote(word) for word in full)])


def context(args: argparse.Namespace) -> Ctx:
    root = resolve_root(args.root, args.worktree)
    work_dir = args.work_dir or str(Path(root) / ".tillr" / "loop")
    now = args.now or datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    return Ctx(
        item=args.item,
        lane=args.lane,
        run=args.run,
        worktree=str(Path(args.worktree).resolve()),
        base=args.base,
        head=args.head,
        root=root,
        store=args.store or str(Path(root) / ".tillr" / "state.db"),
        work_dir=work_dir,
        now=now,
        registry=getattr(args, "registry", None) or os.environ.get(REGISTRY_ENV) or None,
        gate_program=gate_program(args),
        base_ref=getattr(args, "base_ref", None),
        message_from=getattr(args, "message_from", None),
        observed_trunk=getattr(args, "observed_trunk", None),
        verdict=getattr(args, "verdict", None),
        gate_bin=args.tillr_gate,
        land_bin=args.tillr_land,
        item_bin=args.tillr_item,
    )


def print_self_check(ctx: Ctx) -> int:
    """Name the three programs and the argv each would pass, running nothing."""
    print("tillr-loop self-check: one tick's three judgments, and the argv behind them")
    print(
        f"tick    item={ctx.item} lane={ctx.lane or '-'} run={ctx.run} "
        f"base={ctx.base} head={ctx.head} worktree={ctx.worktree}"
    )
    missing = False
    for kind in ("gate", "land", "verdict"):
        print(f"\n{kind:7} {PROGRAM_STRING[kind]}")
        try:
            steps = COMPOSERS[kind](ctx, dry=True)
        except Refusal as refusal:
            # The refusal is the answer: a step that cannot compose cannot judge, and an
            # operator wants to see that before a night of ticks, not after one.
            print(f"        REFUSED (exit {refusal.code}): {refusal.message}")
            missing = True
            continue
        for step in steps:
            shown = " ".join(shlex.quote(word) for word in step.argv)
            if step.stdout:
                shown += " > " + shlex.quote(step.stdout)
            if step.env:
                shown += "  (" + " ".join(f"{k}={v}" for k, v in step.env.items()) + ")"
            if "MISSING" in shown:
                missing = True
            print(f"        {shown}    (in {step.cwd})")
    print("\nloop    tillr drain loop --root " + shlex.quote(ctx.root)
          + " --gate " + shlex.quote(PROGRAM_STRING["gate"])
          + " --land " + shlex.quote(PROGRAM_STRING["land"])
          + " --verdict " + shlex.quote(PROGRAM_STRING["verdict"]))
    if missing:
        print("\ntillr-loop self-check: a judge is missing or a step refused: the loop "
              "would stop rather than pass a candidate nobody judged", file=sys.stderr)
        return EXIT_EXTERNAL
    return EXIT_PASS


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return EXIT_PASS if argv else EXIT_USAGE
    kind, rest = argv[0], argv[1:]
    if kind not in COMPOSERS and kind != "self-check":
        print(f"tillr-loop: {kind!r} is not a step: want gate, land, verdict or self-check",
              file=sys.stderr)
        return EXIT_USAGE
    args = parser_for(kind).parse_args(rest)
    if args.check_argv:
        return EXIT_PASS
    try:
        ctx = context(args)
        if kind == "self-check":
            return print_self_check(ctx)
        return execute(kind, COMPOSERS[kind](ctx, dry=False))
    except Refusal as refusal:
        print(f"tillr-loop {kind}: {refusal.message}", file=sys.stderr)
        return refusal.code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
