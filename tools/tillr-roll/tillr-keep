#!/usr/bin/env python3
"""Keep the repository's drain alive, without changing any item decision.

Starts or adopts tillr-drain in this checkout, waits for exit, then restarts it.
Short runs (under five minutes) wait 60s, 120s, 240s, ... up to 30 minutes.
A run of at least five minutes resets the wait to 60s. --stop leaves the loop alive.
Linux /proc supplies process names and identities. A process named tillr-drain is the
loop only when its arguments are the loop face for this checkout: argv is parsed, never
searched for a substring, so a `tillr-drain why` or `plan` beside the loop is not adopted.
"""
import argparse
from datetime import datetime, timezone
import fcntl
import json
import os
from pathlib import Path
import re
import shlex
import signal
import sqlite3
import subprocess
import sys
import threading
import time


def process(pid):
    """Return the kernel name, birth time, and state, or None after exit."""
    try:
        directory = Path("/proc") / str(pid)
        fields = (directory / "stat").read_text().rsplit(") ", 1)[1].split()
        return (directory.joinpath("comm").read_text().strip(), fields[19], fields[0])
    except (FileNotFoundError, ProcessLookupError):
        return None


DRAIN_NAME = re.compile(r"tillr-drain(?:-[0-9a-f]+)?")


def loop_argv(pid):
    """Return the arguments after `tillr-drain` for pid, or None."""
    raw = (Path("/proc") / str(pid) / "cmdline").read_bytes()
    argv = [arg.decode("utf-8", "replace") for arg in raw.split(b"\0")[:-1]]
    for index, arg in enumerate(argv[:2]):
        if DRAIN_NAME.fullmatch(os.path.basename(arg)):
            return argv[index + 1:]
    return None


def is_loop_face(pid, root):
    """Whether pid's arguments are `tillr-drain loop` for root, read from /proc cmdline.

    The program is the first argument whose base name is the drain's (argv[0] for the
    binary, argv[1] when an interpreter runs a script of that name); the face is the next
    argument. A --root, when given, must name this checkout; without one the loop's root
    is its working directory, which find_loop has already matched.
    """
    rest = loop_argv(pid)
    if rest is None or rest[:1] != ["loop"]:
        return False
    named = None
    for position, arg in enumerate(rest[1:], start=1):
        if arg in ("--root", "-root") and position + 1 < len(rest):
            named = rest[position + 1]
        elif arg.startswith(("--root=", "-root=")):
            named = arg.split("=", 1)[1]
    return named is None or (root / named).resolve() == root.resolve()


def extract_policy_and_lanes(args):
    """Extract --policy and --lanes values from loop arguments."""
    policy = None
    lanes = None
    index = 0
    while index < len(args):
        arg = args[index]
        if arg in ("--policy", "-policy") and index + 1 < len(args):
            policy = args[index + 1]
            index += 2
        elif arg.startswith(("--policy=", "-policy=")):
            policy = arg.split("=", 1)[1]
            index += 1
        elif arg in ("--lanes", "-lanes") and index + 1 < len(args):
            lanes = args[index + 1]
            index += 2
        elif arg.startswith(("--lanes=", "-lanes=")):
            lanes = arg.split("=", 1)[1]
            index += 1
        else:
            index += 1
    return policy, lanes


def strip_lanes(args):
    """Return loop arguments with any --lanes / -lanes option removed."""
    cleaned = []
    index = 0
    while index < len(args):
        arg = args[index]
        if arg in ("--lanes", "-lanes") and index + 1 < len(args):
            index += 2
        elif arg.startswith(("--lanes=", "-lanes=")):
            index += 1
        else:
            cleaned.append(arg)
            index += 1
    return cleaned


def read_saved_ordinary_lanes(root):
    """Read (lanes_str, updated_at) from .tillr/state.db without creating or mutating it."""
    db_path = root / ".tillr/state.db"
    if not db_path.is_file():
        return None, None
    try:
        conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=1.0)
    except sqlite3.Error:
        return None, None
    try:
        row = conn.execute(
            "SELECT value_json, updated_at FROM drain_runtime_config WHERE key='ordinary_lanes'"
        ).fetchone()
    except sqlite3.Error:
        return None, None
    finally:
        conn.close()
    if row is None:
        return None, None
    value_raw, updated_raw = row
    try:
        lanes_val = str(int(json.loads(value_raw)))
    except (TypeError, ValueError, json.JSONDecodeError):
        return None, None
    updated_at = None
    if isinstance(updated_raw, str) and updated_raw:
        try:
            updated_at = datetime.fromisoformat(updated_raw.replace("Z", "+00:00"))
        except ValueError:
            updated_at = None
    return lanes_val, updated_at


def launch_extra_for_attempt(root, extra, session_start, adopted, launches):
    """Return loop extra args for launch; drop boot --lanes once runtime config was seeded in this session."""
    if adopted:
        return strip_lanes(extra)
    if launches > 0:
        saved_lanes, updated_at = read_saved_ordinary_lanes(root)
        if saved_lanes is not None and updated_at is not None and updated_at >= session_start:
            return strip_lanes(extra)
    return list(extra)


def find_loop(root):
    """Find this user's own-named drain in this checkout, not another repository."""
    found = []
    for directory in Path("/proc").iterdir():
        if not directory.name.isdigit():
            continue
        try:
            if directory.stat().st_uid != os.getuid():
                continue
            info = process(int(directory.name))
            # The pack execs tillr-drain-<source digest>; Linux exposes only the
            # first 15 bytes of that executable name (three digest characters).
            if info is None or not re.fullmatch(r"tillr-drain(?:-[0-9a-f]{3})?", info[0]) or info[2] == "Z":
                continue
            if directory.joinpath("cwd").resolve(strict=True) != root.resolve():
                continue
            if is_loop_face(int(directory.name), root):
                found.append(int(directory.name))
        except (FileNotFoundError, ProcessLookupError):
            continue
    if len(found) > 1:
        raise RuntimeError(f"multiple tillr-drain processes in {root}: {found}; stop the extra loops first")
    return found[0] if found else None


def restart_delay(delay, elapsed):
    if elapsed >= 300:
        return 60, 60
    return delay, min(delay * 2, 1800)


def keep(stop, find, launch, observe, wait, clock=time.monotonic):
    delay = 60
    while not stop.is_set():
        child = find()
        if stop.is_set():
            return
        if child is None:
            child = launch()
        started = clock()
        if not observe(child) or stop.is_set():
            return
        seconds, delay = restart_delay(delay, clock() - started)
        print(f"keeper: loop exited; restart in {seconds}s", flush=True)
        if wait(seconds):
            return


def observe_loop(stop, child):
    """Wait for a child or adopted process to exit, without stopping it."""
    owned = isinstance(child, subprocess.Popen)
    pid = child.pid if owned else child
    original = process(pid)
    print(f"keeper: watching loop {pid}", flush=True)
    if not owned and original is None:
        return True
    while not stop.is_set():
        if owned:
            if child.poll() is not None:
                return True
        else:
            current = process(pid)
            if current is None or current[2] == "Z" or current[:2] != original[:2]:
                return True
        stop.wait(1)
    return False


def loop_command(root, extra):
    adapter = root / "tools/tillr-loop/tillr-loop"
    command = ["tillr-drain", "loop", "--root", str(root)]
    for face in ("gate", "land", "verdict"):
        command.extend(["--" + face, shlex.join(["python3", str(adapter), face])])
    return command + extra


def read_recorded_launch(root):
    """Read the last recorded policy and lane count from .tillr/keeper.launch.json."""
    path = root / ".tillr/keeper.launch.json"
    try:
        data = json.loads(path.read_text())
    except FileNotFoundError:
        return None, None
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError(f"unreadable recorded launch {path}: {error}") from error
    return data.get("policy"), data.get("lanes")


def write_recorded_launch(root, policy, lanes):
    """Record policy and lane count so a later restart can reuse them."""
    path = root / ".tillr/keeper.launch.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = {}
    if policy is not None:
        payload["policy"] = policy
    if lanes is not None:
        payload["lanes"] = str(lanes)
    path.write_text(json.dumps(payload, sort_keys=True) + "\n")


def resolve_restart_args(root, extra, loop_pid):
    """Determine policy and lanes from the running loop, runtime config, or recorded launch, plus extra."""
    extra_policy, extra_lanes = extract_policy_and_lanes(extra)
    running_policy, running_lanes = (None, None)
    if loop_pid is not None:
        rest = loop_argv(loop_pid)
        if rest is not None and rest[:1] == ["loop"]:
            running_policy, running_lanes = extract_policy_and_lanes(rest[1:])
    rec_policy, rec_lanes = read_recorded_launch(root)
    saved_lanes, _ = read_saved_ordinary_lanes(root)
    policy = extra_policy if extra_policy is not None else (running_policy if running_policy is not None else rec_policy)
    if extra_lanes is not None:
        lanes = extra_lanes
    elif saved_lanes is not None:
        lanes = saved_lanes
    else:
        lanes = running_lanes if running_lanes is not None else rec_lanes
    args = list(extra)
    if policy is not None and extra_policy is None:
        args.extend(["--policy", policy])
    if lanes is not None and extra_lanes is None and saved_lanes is None:
        args.extend(["--lanes", str(lanes)])
    return args, policy, lanes


def wait_for_exit(pid, report_interval=30, poll_interval=0.05, clock=None, sleep=None):
    """Wait until pid exits or becomes a zombie, printing what is being waited on."""
    clock = time.monotonic if clock is None else clock
    sleep = time.sleep if sleep is None else sleep
    original = process(pid)
    if original is None or original[2] == "Z":
        return
    print(f"restart: waiting for loop {pid} to exit", flush=True)
    last_report = clock()
    while True:
        current = process(pid)
        if current is None or current[2] == "Z" or current[:2] != original[:2]:
            return
        now = clock()
        if report_interval is not None and now - last_report >= report_interval:
            print(f"restart: still waiting for loop {pid} to exit", flush=True)
            last_report = now
        sleep(poll_interval)


def wait_for_keeper_exit(path, timeout=30):
    """Wait until the keeper lock is released."""
    if not path.exists():
        return
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            with path.open("r") as lock:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return
        except FileNotFoundError:
            return
        except BlockingIOError:
            time.sleep(0.05)
    raise RuntimeError(f"keeper lock {path} stayed held after {timeout}s")


def stop_keeper(path):
    try:
        lock = path.open("r")
    except FileNotFoundError:
        print("keeper: not running")
        return
    with lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            record = json.load(lock)
            # Open a kernel process handle BEFORE checking birth time: even if the PID
            # is reused between verification and signaling, only this process is signaled.
            try:
                fd = os.pidfd_open(record["pid"])
            except ProcessLookupError:
                print("keeper: already exited")
                return
            try:
                info = process(record["pid"])
                if info is None or info[1] != record["start"]:
                    raise RuntimeError("keeper identity changed; refusing to signal a reused PID")
                signal.pidfd_send_signal(fd, signal.SIGTERM)
            finally:
                os.close(fd)
            print("keeper: stop requested; loop left running")
        else:
            print("keeper: not running")


def restart_drain(root, extra, lock_path, build_cmd=None, drain_bin="tillr-drain"):
    """Stand the keeper down, stop the loop, wait for exit, build from HEAD, and start the keeper."""
    # 1. Read policy and lane count from the running loop (if any) or recorded launch BEFORE stopping.
    loop_pid = find_loop(root)
    restart_args, policy, lanes = resolve_restart_args(root, extra, loop_pid)

    # 2. Stand the keeper down.
    stop_keeper(lock_path)
    wait_for_keeper_exit(lock_path)

    # 3. Stop the loop if running, and wait for it to exit.
    if loop_pid is not None:
        print(f"restart: stopping loop {loop_pid}", flush=True)
        stop_result = subprocess.run([drain_bin, "stop", "--root", str(root)],
                                     capture_output=True, text=True)
        if stop_result.returncode not in (0, 2):
            detail = (stop_result.stderr or stop_result.stdout).strip()
            raise RuntimeError(f"tillr-drain stop failed ({stop_result.returncode}): {detail}")
        wait_for_exit(loop_pid)
        print(f"restart: loop {loop_pid} exited", flush=True)
    else:
        print("restart: no loop running", flush=True)

    # 4. Build from the current HEAD.
    head = subprocess.check_output(["git", "-C", str(root), "rev-parse", "HEAD"], text=True).strip()
    env = {**os.environ, "TILLR_BUILD_UNPROVED": head}
    cmd = build_cmd if build_cmd is not None else ["just", "--justfile", str(root / ".justfile"), "tillr-build"]
    print(f"restart: building from HEAD {head[:12]}", flush=True)
    subprocess.run(cmd, cwd=root, env=env, check=True)

    # 5. Start the keeper again in the background with the resolved policy and lane count.
    keeper_cmd = [sys.executable, str(Path(__file__).resolve()), "--root", str(root)]
    if restart_args:
        keeper_cmd.append("--")
        keeper_cmd.extend(restart_args)
    durable = os.environ.get("YOLO_DURABLE_DIR")
    log_dir = Path(durable).resolve() if durable else root / ".tillr"
    log_dir.mkdir(parents=True, exist_ok=True)
    log_path = log_dir / "keeper.log"
    with log_path.open("a") as log_file:
        keeper_proc = subprocess.Popen(
            keeper_cmd,
            cwd=root,
            stdin=subprocess.DEVNULL,
            stdout=log_file,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    summary = []
    if policy is not None:
        summary.append(f"policy={policy}")
    if lanes is not None:
        summary.append(f"lanes={lanes}")
    detail = f" ({', '.join(summary)})" if summary else ""
    print(f"restart: started keeper {keeper_proc.pid}{detail}; log: {log_path}", flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path.cwd(), help="repository checkout (default: current directory)")
    parser.add_argument("--stop", action="store_true", help="stop only the keeper for this checkout")
    parser.add_argument("--restart", action="store_true", help="stand keeper down, stop loop, wait for exit, build HEAD, and restart keeper")
    parser.add_argument("loop_args", nargs=argparse.REMAINDER, help="additional loop arguments after --")
    args = parser.parse_args()
    root = args.root.resolve()
    extra = args.loop_args
    if extra[:1] == ["--"]:
        extra = extra[1:]
    # Discovery is scoped by cwd, so moving the child's root elsewhere would break
    # adoption. The keeper, not a passthrough option, owns that one value.
    if any(value in ("--root", "-root") or value.startswith(("--root=", "-root=")) for value in extra):
        parser.error("name the checkout with the keeper's --root, not a loop override")
    if args.stop and extra:
        parser.error("--stop does not take loop arguments")
    if args.stop and args.restart:
        parser.error("--stop and --restart cannot be combined")
    if not Path("/proc/self/comm").is_file() or not hasattr(os, "pidfd_open"):
        parser.error("the keeper needs Linux /proc and process handles")
    path = root / ".tillr/keeper.lock"
    try:
        if args.stop:
            stop_keeper(path)
            return 0
        if args.restart:
            restart_drain(root, extra, path)
            return 0
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a+") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise RuntimeError("keeper already running; use --stop to stop only it")
            stop = threading.Event()
            signal.signal(signal.SIGTERM, lambda *_: stop.set())
            signal.signal(signal.SIGINT, lambda *_: stop.set())
            lock.seek(0)
            lock.truncate()
            json.dump({"pid": os.getpid(), "start": process(os.getpid())[1]}, lock)
            lock.flush()

            extra_policy, extra_lanes = extract_policy_and_lanes(extra)
            if extra_policy is not None or extra_lanes is not None:
                write_recorded_launch(root, extra_policy, extra_lanes)

            session_start = datetime.now(timezone.utc)
            adopted = False
            launches = 0

            def launch():
                nonlocal launches
                # A separate session keeps terminal Ctrl-C and --stop away from the
                # loop. Never terminate, authorize a retry, or write to its store here.
                attempt_extra = launch_extra_for_attempt(root, extra, session_start, adopted, launches)
                launches += 1
                child = subprocess.Popen(loop_command(root, attempt_extra), cwd=root,
                                         stdin=subprocess.DEVNULL, start_new_session=True)
                print(f"keeper: started loop {child.pid}", flush=True)
                return child

            def find_and_record():
                nonlocal adopted
                pid = find_loop(root)
                if pid is not None:
                    adopted = True
                    rest = loop_argv(pid)
                    if rest[:1] == ["loop"] if rest is not None else False:
                        p, l = extract_policy_and_lanes(rest[1:])
                        saved_lanes, _ = read_saved_ordinary_lanes(root)
                        effective_lanes = saved_lanes if saved_lanes is not None else l
                        if p is not None or effective_lanes is not None:
                            write_recorded_launch(root, p, effective_lanes)
                return pid

            keep(stop, find_and_record, launch,
                 lambda child: observe_loop(stop, child), stop.wait)
            print("keeper: stopped; loop left running", flush=True)
        return 0
    except (OSError, RuntimeError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        print(f"keeper: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
