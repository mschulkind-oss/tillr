#!/bin/sh
# The Pi proof adapter: the same contract, a maximally different harness.
#
# Design §7 ships this beside the muse adapter because Pi differs at BOTH seams the
# contract leaves adapter-private: the brief arrives on stdin rather than as a
# prompt-file flag, and effort is Pi's own `--thinking` level rather than the muse's
# `--reasoning-effort`. If one brief template, one backend field and one report shape
# serve both, the shape is proved rather than one harness's habits wearing a general name.
#
# What is mechanically confining: NOTHING beyond the boundary snapshot. Pi offers no OS
# sandbox for its shell tool, so this adapter makes no claim the muse adapter's
# sandbox claim would borrow. That is stated in README.md, and it is why the driver's
# boundary.before/boundary.after pair, not this file, is Pi's boundary.
#
# Writes: stdout is Pi's event stream in `--mode json`; the harness's stderr goes to
# `stream.err` beside the brief. Exit: the harness's own code, or 124 from the wall, or 2
# from a refusal that ran nothing.
set -eu

PROG=run-pi
SELF_DIR=$(dirname -- "$0")
. "$SELF_DIR/../preflight.sh"
PI_HARNESS_SOURCED=1
. "$SELF_DIR/pi-harness.sh"

backend=
model=
effort=
brief=../brief.md
target=
# No wall unless staging passes one: a total-run bound is a budget, not a fault detector,
# and the 1800s default killed runs that had already committed (design D-RW1,
# run-wall-ruling.md). `--timeout N` still bounds this run, and N == 0 is the same as no
# wall.
wall=
session_override=

usage() {
    cat <<'USAGE'
usage: run-pi --backend pi --model PATTERN --effort LEVEL
              [--brief PATH] [--target PATH] [--timeout SECONDS] [--session-id UUID]

  --model     a Pi model pattern (`provider/id`, optionally `:thinking`)
  --effort    a Pi thinking level: off|minimal|low|medium|high|xhigh|max
  --brief     the staged brief; default ../brief.md
  --target    the named target; default the cwd, and it must BE the cwd
  --session-id  the stager-minted UUID; default the lane's session-id file
  --timeout   the wall in seconds; omitted or 0 runs unbounded
USAGE
}

while [ $# -gt 0 ]; do
    case $1 in
        --backend) [ $# -ge 2 ] || refuse "--backend needs a value"; backend=$2; shift 2 ;;
        --model) [ $# -ge 2 ] || refuse "--model needs a value"; model=$2; shift 2 ;;
        --effort) [ $# -ge 2 ] || refuse "--effort needs a value"; effort=$2; shift 2 ;;
        --brief) [ $# -ge 2 ] || refuse "--brief needs a value"; brief=$2; shift 2 ;;
        --target) [ $# -ge 2 ] || refuse "--target needs a value"; target=$2; shift 2 ;;
        --timeout) [ $# -ge 2 ] || refuse "--timeout needs a value"; wall=$2; shift 2 ;;
        --session-id) [ $# -ge 2 ] || refuse "--session-id needs a value"; session_override=$2; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) refuse "unknown argument '$1'" ;;
    esac
done

require_backend "$backend" pi
check_wall "$wall"
require_opt --model "$model" "the model comes from the backend policy at staging; an adapter default would be a model id in a tree that names no vendor"
require_opt --effort "$effort" "the thinking level comes from the backend policy at staging, with no default of its own"
preflight_brief "$brief"
pi_apply_yolo_session_home
pi_resolve_harness
target=$(resolve_target "$target")

err=$(lane_path "$brief" stream.err)
# A continuation replaces only the first prompt, never the staged brief.
prompt=${TILLR_RESUME_PROMPT_FILE:-$brief}
session=$session_override
if [ -z "$session" ] && [ -r "$(lane_path "$brief" session-id)" ]; then
    session=$(cat "$(lane_path "$brief" session-id)")
fi

# Keep the brief path in BOARD_DRAIN_BRIEF for extensions, but deliver its contents on
# stdin. Pi prepends piped input to its first prompt. A conflict brief can exceed the
# operating system's per-argument limit, so neither argv nor an environment value may
# carry the contents.
# --- the recording seam -------------------------------------------------------------
#
# docs/design/session-recording.md §2.2 puts the two missing observation seams here,
# in the parent of everything a run spawns: `BASH_ENV` records every shell command a
# run's `bash` tool starts. It appends
# to the run's own record directory — `<root>/.tillr/loop/<run-id>/`, the directory
# staging keeps this run's brief, fence and base sha in and `tillr-trace` indexes.
#
# Every guard below is fail-open (§7.1): a run with no run id, no shim, or a record
# directory that cannot be created proceeds with the emitter silently absent — never a
# failed run, never an exit code recording caused.
# Git trace2 recording was removed on 2026-11-17 (owner ruling): its variables would be
# inherited by every test suite the run starts and recorded hundreds of thousands of git
# calls per run. They are never set here and never passed through from the loop's own
# environment either.
unset GIT_TRACE2_EVENT GIT_TRACE2_PARENT_SID GIT_TRACE2 GIT_TRACE2_PERF
trace_dir=${TILLR_TRACE_DIR:-}
repo_root=
# A linked worktree's git common directory is the main checkout's `.git`, whose parent
# is the repository root: the derivation `tillr-loop` already uses so the gate, the
# lander and this adapter agree on one `.tillr/loop`.
#
# It is derived whether or not the trace directory is preset: `TILLR_REPO_ROOT` is what
# makes each row's `repo_rel_cwd` repo-relative, the field the §8.3 owed-suite join keys
# on, and a preset `TILLR_TRACE_DIR` must not cost the rows that field.
if common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
    repo_root=$(dirname -- "$common")
fi
if [ -n "${TILLR_RUN_ID:-}" ] && [ -z "$trace_dir" ] && [ -n "$repo_root" ]; then
    trace_dir=$repo_root/.tillr/loop/$TILLR_RUN_ID
fi
shim=
if trace_parent=$(cd -- "$SELF_DIR/../../../tillr-trace" 2>/dev/null && pwd -P); then
    shim=$trace_parent/bash-shim.sh
fi
if [ -n "$trace_dir" ] && [ -r "$shim" ] && mkdir -p -- "$trace_dir" 2>/dev/null && [ -w "$trace_dir" ]; then
    TILLR_TRACE_DIR=$trace_dir
    BASH_ENV=$shim
    export TILLR_TRACE_DIR BASH_ENV
    if [ -n "$repo_root" ]; then
        TILLR_REPO_ROOT=$repo_root
        export TILLR_REPO_ROOT
    fi
fi

BOARD_DRAIN_BRIEF=$(cd "$(dirname -- "$brief")" && pwd -P)/$(basename -- "$brief")
# The three seam names every agent extension may use to tell a lane's worker from an
# interactive session. `BOARD_DRAIN_RUN` was never set and `BOARD_DRAIN_SESSION` was set to
# the session id, which is EMPTY when the driver does not mint one — so both halves of the
# check read "" and `steering-timer.ts`'s isChildSession said "not a child". Measured
# 2026-11-14: a lane worker ran the whale's check-in, wrote shadow rulings, ran
# `git update-ref refs/tillr/stranded/*` four times inside the drain's own boundary bracket,
# and crashed the loop with StopHostBoundaryViolation. Never leave these empty.
BOARD_DRAIN_RUN=${TILLR_RUN_ID:-tillr-lane}
BOARD_DRAIN_SESSION=${session:-${TILLR_RUN_ID:-tillr-lane}}
export BOARD_DRAIN_BRIEF BOARD_DRAIN_RUN BOARD_DRAIN_SESSION

. "$SELF_DIR/pi-agent-dir.sh"

# Isolate persisted child metadata by tillr run, not by the interactive parent's
# runtime root. Exec consumes Pi's status/history plus sessionFile tool results.
if [ -n "${TILLR_CHILD_SESSIONS_ROOT:-}" ] && [ -n "${TILLR_CHILD_SESSIONS_MARKER:-}" ]; then
    mkdir -p -- "$TILLR_CHILD_SESSIONS_ROOT"
    PI_SUBAGENTS_TEMP_ROOT=$TILLR_CHILD_SESSIONS_ROOT
    export PI_SUBAGENTS_TEMP_ROOT
    printf '%s\n' pi-subagents-v1 > "$TILLR_CHILD_SESSIONS_MARKER"
fi

pi_prepare_harness_env
landing_promptless=
set -- "$PI_HARNESS_BIN" --print --mode json --model "$model" --thinking "$effort"
if [ -n "$session" ]; then
    if [ "${TILLR_SESSION_MODE:-new}" = resume ]; then
        # --session-id creates a cold session when the id is gone. --session
        # requires an existing session, so the drain can record and replace a
        # failed continuation instead of mislabeling that cold start.
        set -- "$@" --session "$session"
    else
        set -- "$@" --session-id "$session"
    fi
fi

# A run whose goal is a commit keeps going until it has one (keep-going.ts). That is a
# worker in a lane worktree, with the base sha staging wrote beside its brief, that is
# not a read-only node: a judge, a fork checkout and a plain directory have other goals,
# and their briefs do not name a lane worktree target.
goal_base=
target_kind=$(sed -n 's/^- \*\*Target:\*\* .* (\(.*\))$/\1/p' "$brief" | head -n 1)
if [ -z "${TILLR_READ_ONLY_GROUP:-}" ] && [ "$target_kind" = "lane worktree" ] && [ -r "$(lane_path "$brief" base_sha)" ] &&
    ! grep -Eq '^Run only node .+ on the .+ seat; access: read_only\.$' "$brief"; then
    goal_base=$(tr -d ' \n' <"$(lane_path "$brief" base_sha)")
fi
unset TILLR_CALL_SUSPENDS
if [ -n "$goal_base" ]; then
    TILLR_GOAL_BASE=$goal_base
    export TILLR_GOAL_BASE
    set -- "$@" -e "$(cd -- "$SELF_DIR" && pwd -P)/keep-going.ts"
    capability=$(lane_path "$brief" ending-capability)
    if [ -r "$capability" ] && [ "$(cat "$capability")" = call-suspends ]; then
        require_harness python3
        TILLR_CALL_SUSPENDS=1
        export TILLR_CALL_SUSPENDS
        set -- "$@" -e "$(cd -- "$SELF_DIR" && pwd -P)/land.ts" -e "$(cd -- "$SELF_DIR" && pwd -P)/obstacle.ts"
        if [ -n "${YOLO_DURABLE_DIR:-}" ] && [ -e "$YOLO_DURABLE_DIR/landing-answer.json" ]; then
            [ -n "$session" ] && [ "${TILLR_SESSION_MODE:-new}" = resume ] || refuse "landing answer requires an existing Pi session"
            landing_dir=$YOLO_DURABLE_DIR
            landing_prompt=$landing_dir/landing-prompt
            landing_id=$landing_dir/landing-call-id
            if ! python3 - "$landing_dir/landing-answer.json" "$landing_id" "$landing_prompt" <<'PY'
import json, sys
try:
    with open(sys.argv[1], encoding='utf-8') as source:
        answer = json.load(source)
    call, text = answer['call_id'], answer['text']
    if not isinstance(call, str) or not call or not isinstance(text, str) or not text:
        raise ValueError('missing call id or text')
    with open(sys.argv[2], 'w', encoding='utf-8') as output:
        output.write(call)
    with open(sys.argv[3], 'w', encoding='utf-8') as output:
        output.write(text)
except (OSError, ValueError, TypeError, KeyError):
    sys.exit(1)
PY
            then
                refuse "landing answer requires a call id and text"
            fi
            transcript=
            if [ -r "$landing_dir/landing-transcript" ]; then
                transcript=$(cat "$landing_dir/landing-transcript")
            fi
            if [ -n "$transcript" ] && [ ! -e "$transcript" ]; then
                printf 'Pi landing transcript not found: %s\n' "$transcript" >&2
                exit 1
            fi
            if [ -n "$transcript" ] && "$SELF_DIR/landing-call-held" "$transcript" "$(cat "$landing_id")"; then
                printf '%s\n' tool-result > "$landing_dir/landing-delivery"
                prompt=/dev/null
                landing_promptless=1
            else
                printf '%s\n' message > "$landing_dir/landing-delivery"
                prompt=$landing_prompt
            fi
        fi
    fi
    # The writer's session carries what its work uses and nothing an interactive session
    # adds. Discovery is off, so no installed package loads by itself: no memory
    # injection, no web, session-search, todo or code-mode tools and no session recap;
    # no skills index; and no context-file discovery, so no house briefing written for an
    # interactive agent. The target's own AGENTS.md is appended instead, because the gate
    # enforces it. Two packages a worker uses are loaded by name when installed:
    # sub-agents and background tasks. Every single-file extension in the agent's own
    # extensions directory is loaded back too, because that is where the provider,
    # billing tier, usage-ledger and quota plumbing lives (yolo-*, bedrock-*,
    # usage-capture, quota-resume), and a worker that skipped it would bill and fail
    # differently from every other session. The one left out is steering-timer, whose
    # tools are an interactive owner's. Measured 2026-11-18 on one first turn: 23354
    # prompt tokens before, 9350 after.
    agent_dir=${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}
    set -- "$@" --no-extensions --no-skills --no-context-files --no-prompt-templates
    for extension in "$agent_dir"/extensions/*.ts "$agent_dir"/extensions/*.js; do
        case ${extension##*/} in steering-timer.ts) continue ;; esac
        [ -f "$extension" ] && set -- "$@" -e "$extension"
    done
    for package in pi-subagents pi-background-tasks; do
        [ -d "$agent_dir/yolo-patched/$package" ] && set -- "$@" -e "$agent_dir/yolo-patched/$package"
    done
    # The target's own copy, which is the lane's tree, not the trunk's.
    if [ -r AGENTS.md ]; then
        set -- "$@" --append-system-prompt "$(pwd -P)/AGENTS.md"
    fi
else
    unset TILLR_GOAL_BASE
    if [ "${PI_AGENT_DIR_BUILT:-0}" -eq 1 ]; then
        agent_dir=${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}
        set -- "$@" --no-extensions
        for extension in "$agent_dir"/extensions/*.ts "$agent_dir"/extensions/*.js; do
            [ -f "$extension" ] && set -- "$@" -e "$extension"
        done
        if command -v python3 >/dev/null 2>&1; then
            _pi_bin=${PI_HARNESS_BIN:-$(command -v pi 2>/dev/null || true)}
            _old_ifs=$IFS
            IFS='
'
            set -f
            for _pkg_ext in $(python3 - "$agent_dir" "$_pi_bin" <<'PY'
import json, os, re, sys
from pathlib import Path

agent_dir = Path(sys.argv[1])
pi_bin = sys.argv[2]

settings_path = agent_dir / "settings.json"
if settings_path.is_file():
    try:
        data = json.loads(settings_path.read_text(encoding="utf-8"))
        for entry in data.get("packages", []):
            if not isinstance(entry, str):
                continue
            if entry.startswith("~/.pi/agent/yolo-patched/"):
                pkg = entry[len("~/.pi/agent/yolo-patched/"):]
                target = agent_dir / "yolo-patched" / pkg
                if target.exists():
                    print(str(target))
            elif entry.startswith("npm:"):
                rest = entry[len("npm:"):]
                if rest.startswith("@") and "/" in rest:
                    scope, name_ver = rest.split("/", 1)
                    pkg = scope + "/" + name_ver.split("@", 1)[0]
                else:
                    pkg = rest.split("@", 1)[0]
                target = agent_dir / "npm" / "node_modules" / pkg
                if target.exists():
                    print(str(target))
            elif os.path.exists(entry):
                print(entry)
    except Exception:
        pass

dist_candidates = []
if pi_bin:
    p = Path(pi_bin).resolve()
    dist_candidates.extend([
        p.parent / "extensions",
        p.parent.parent / "extensions",
        p.parent / "node_modules/@earendil-works/pi-coding-agent/dist/extensions",
        p.parent.parent / "lib/node_modules/@earendil-works/pi-coding-agent/dist/extensions",
        p.parent.parent / "node_modules/@earendil-works/pi-coding-agent/dist/extensions",
    ])
    try:
        if p.is_file() and p.stat().st_size < 65536:
            text = p.read_text(encoding="utf-8", errors="ignore")
            for m in re.findall(r'(/[^"\'\s]+/node_modules(?:/\.bin/pi|/@earendil-works/pi-coding-agent))', text):
                mp = Path(m)
                if mp.name == "pi":
                    dist_candidates.append(mp.parent.parent / "@earendil-works/pi-coding-agent/dist/extensions")
                else:
                    dist_candidates.append(mp / "dist/extensions")
    except Exception:
        pass
dist_candidates.append(Path.home() / ".local/share/pi-fork/node_modules/@earendil-works/pi-coding-agent/dist/extensions")

for cand in dist_candidates:
    if cand.is_dir():
        for name in ("llama", "codemode", "tool-search", "mcp"):
            idx = cand / name / "index.js"
            if idx.is_file():
                print(str(idx))
        break
PY
            ); do
                [ -n "$_pkg_ext" ] && set -- "$@" -e "$_pkg_ext"
            done
            set +f
            IFS=$_old_ifs
            unset _pi_bin _old_ifs _pkg_ext
        fi
    fi
fi

# Only runner-managed launches have a pause file. Keep pi's PID private to the
# watcher: signaling a timeout wrapper or process group would also signal tools.
if [ -n "${TILLR_PAUSE_REQUEST:-}" ]; then
    require_harness python3
    set -- python3 "$SELF_DIR/stop-at-gap" "$TILLR_PAUSE_REQUEST" "$@"
fi

# The wall wraps the whole argv, so the bound is one process group and not the harness's
# own turn: omitted (or 0) prepends nothing at all.
if [ -n "$wall" ] && [ "$wall" -gt 0 ]; then
    set -- timeout "$wall" "$@"
fi

if [ -n "$landing_promptless" ]; then
    copy=$landing_dir/landing-output
    status=$landing_dir/landing-status
    {
        if "$@" </dev/null 2>"$err"; then
            printf '%s\n' 0 > "$status"
        else
            printf '%s\n' "$?" > "$status"
        fi
    } | tee "$copy"
    code=$(cat "$status")
    if [ "$code" -ne 0 ] && python3 - "$copy" <<'PY'
import json, sys
with open(sys.argv[1], encoding='utf-8', errors='replace') as source:
    for line in source:
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if isinstance(event, dict) and event.get('type') == 'error' and event.get('message') == 'No unanswered tool call or trailing tool result to continue':
            sys.exit(0)
sys.exit(1)
PY
    then
        printf '%s\n' message > "$landing_dir/landing-delivery"
        prompt=$landing_prompt
    else
        exit "$code"
    fi
fi
exec "$@" <"$prompt" 2>"$err"
