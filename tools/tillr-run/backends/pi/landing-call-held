#!/usr/bin/env python3
"""Fail closed unless the active pi transcript can replay this landing call."""
import json
import sys


def held(path, call_id):
    with open(path, encoding='utf-8') as source:
        lines = source.read().splitlines()
    entries = [json.loads(line) for line in lines]
    if not entries or not isinstance(entries[0], dict) or entries[0].get('type') != 'session' or not call_id:
        return False
    by_id = {}
    leaf = None
    for entry in entries[1:]:
        if not isinstance(entry, dict) or not isinstance(entry.get('id'), str) or not entry['id'] or entry['id'] in by_id:
            return False
        by_id[entry['id']] = entry
        leaf = entry['id']
    last_message = None
    saved = False
    visited = set()
    while leaf is not None:
        if not isinstance(leaf, str) or leaf not in by_id or leaf in visited:
            return False
        visited.add(leaf)
        entry = by_id[leaf]
        if entry.get('type') == 'compaction':
            return False
        if entry.get('type') == 'message':
            message = entry.get('message')
            if not isinstance(message, dict):
                return False
            if last_message is None:
                last_message = message
            role = message.get('role')
            if role == 'toolResult' and message.get('toolCallId') == call_id:
                saved = True
            if role == 'assistant':
                content = message.get('content')
                if not isinstance(content, list) or not any(isinstance(part, dict) and part.get('type') == 'toolCall' and part.get('id') == call_id for part in content):
                    return False
                if last_message.get('role') == 'toolResult':
                    return last_message.get('toolCallId') == call_id
                return not saved
        leaf = entry.get('parentId')
    return False


if __name__ == '__main__':
    try:
        sys.exit(0 if len(sys.argv) == 3 and held(sys.argv[1], sys.argv[2]) else 1)
    except (OSError, UnicodeError, ValueError, TypeError):
        sys.exit(1)
