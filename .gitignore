# A tillr store lives in the tree of a repository that uses tillr; it is state, not content.
.tillr/

# The observatory's front end (tools/tillr-view/web, Vite + React). Dependencies are local
# artifacts, and `dist/` is what `just observatory` embeds into the tillr-view binary with
# `-tags observatory`. Both are rebuilt from tracked source -- and both would otherwise be
# picked up by the tillr pack mirror, which copies untracked-but-not-ignored files.
/tools/tillr-view/web/node_modules
/tools/tillr-view/web/dist/
# A stray empty one appears if a test harness installs at the repository root. No trailing
# slash on purpose: a worktree harness may link node_modules to the parent checkout, and a
# pattern ending in / matches directories only.
/node_modules

# Built by `go build` in the module directory; never content.
/tools/tillr-gate/tillr-gate
/tools/tillr-cli/tillr-cli
/tools/tillr-loop/tillr-loop
/tools/tillr-watch/tillr-watch
/tools/tillr-trace/tillr-trace

# Python bytecode.
__pycache__/
*.pyc

# A local jail's machine-specific half; the committed half, if any, is yolo-jail.jsonc.
yolo-jail.local.jsonc
