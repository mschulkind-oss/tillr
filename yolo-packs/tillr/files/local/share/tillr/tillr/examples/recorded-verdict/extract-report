#!/bin/sh
set -eu
out=
log=
while [ $# -gt 0 ]; do
    case "$1" in
        --out) out=$2; shift 2 ;;
        --out=*) out=${1#--out=}; shift ;;
        --) shift; [ $# -gt 0 ] && log=$1; break ;;
        --*=*) shift ;;
        -*) shift 2 ;;
        *) log=$1; shift ;;
    esac
done
[ -n "$out" ] && [ -n "$log" ]
cp -- "$log" "$out"
