#!/usr/bin/env python3
"""Read subscription usage with one authenticated GET; never start Claude Code.

Uses the already-issued subscription token. Does not refresh credentials or
fall back to a paid prompt. An HTTP/auth/schema failure exits nonzero.
"""
import datetime
import json
import math
import os
from pathlib import Path
import sys
import urllib.error
import urllib.request

URL = "https://api.anthropic.com/api/oauth/usage"
BODY_LIMIT = 64 * 1024


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise ValueError("quota endpoint redirect refused")


def access_token():
    token = os.environ.get("CLAUDE_CODE_OAUTH_TOKEN")
    if token:
        return token
    root = os.environ.get("CLAUDE_SECURESTORAGE_CONFIG_DIR") or os.environ.get("CLAUDE_CONFIG_DIR")
    path = Path(root) if root else Path.home() / ".claude"
    try:
        credentials = json.loads((path / ".credentials.json").read_text())
        token = credentials.get("claudeAiOauth", {}).get("accessToken")
    except (OSError, ValueError, AttributeError):
        token = None
    if not isinstance(token, str) or not token:
        raise ValueError("no subscription access token: sign in to Claude Code; quota never starts a model session")
    return token


def normalize(payload):
    if not isinstance(payload, dict) or any(kind not in payload for kind in ("five_hour", "seven_day")):
        raise ValueError("quota response must name both known windows (null only when absent)")
    windows = []
    for kind in ("five_hour", "seven_day"):
        window = payload.get(kind)
        if window is None:
            continue
        if not isinstance(window, dict):
            raise ValueError("invalid quota window")
        used, reset = window.get("utilization"), window.get("resets_at")
        if type(used) not in (float, int) or not math.isfinite(used) or used < 0:
            raise ValueError("invalid quota utilization")
        if reset is None and used == 0:
            windows.append({"kind": kind, "fraction": 0, "reset_at": None})
            continue
        if not isinstance(reset, str):
            raise ValueError("quota window has no reset time")
        try:
            parsed = datetime.datetime.fromisoformat(reset.replace("Z", "+00:00"))
        except ValueError as exc:
            raise ValueError("invalid quota reset time") from exc
        if parsed.tzinfo is None:
            raise ValueError("quota reset time needs a time zone")
        reset = parsed.astimezone(datetime.timezone.utc).isoformat().replace("+00:00", "Z")
        windows.append({"kind": kind, "fraction": used / 100, "reset_at": reset})
    if not windows:
        raise ValueError("quota response has no known windows")
    return {"windows": windows}


def read_quota():
    request = urllib.request.Request(URL, headers={
        "Authorization": "Bearer " + access_token(),
        "anthropic-beta": "oauth-2025-04-20",
        "User-Agent": "claude-cli/2.1.319 (external, cli)",
        "Content-Type": "application/json",
    })
    opener = urllib.request.build_opener(NoRedirect())
    with opener.open(request, timeout=10) as response:
        raw = response.read(BODY_LIMIT + 1)
    if len(raw) > BODY_LIMIT:
        raise ValueError("quota response exceeds 64 KiB")
    return normalize(json.loads(raw))


def main():
    if len(sys.argv) != 1:
        print("usage: quota (reads Claude subscription usage; no model tokens)", file=sys.stderr)
        return 2
    try:
        result = read_quota()
    except urllib.error.HTTPError as exc:
        # Never print upstream response bodies or credentials.
        print(f"claude quota: HTTP {exc.code}; no reading recorded as open", file=sys.stderr)
        return 1
    except (OSError, ValueError) as exc:
        print(f"claude quota: {exc}", file=sys.stderr)
        return 1
    print(json.dumps(result, allow_nan=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
