#!/usr/bin/env python3
"""Watch one pi print-mode process for the runner: pause requests and settled sessions.

Two jobs, both keyed on pi's own statements rather than on a clock:

* Pause: translate the runner's pause file into SIGUSR1 to pi, never its tools.
* Settled with nothing owed: once pi has emitted `agent_settled` and its background-task
  journal shows no wake-policy task still owed to the session, pi's print mode would
  return and the process would exit. When it does not (on 2026-11-18 a wake task
  delivered by the extension's fallback path leaked its session hold, and three workers
  sat settled for seven hours), this watcher ends pi with its documented shutdown
  (SIGTERM, which disposes the runtime and exits 143), appends one
  `tillr_harness_ended` event naming what it did, and exits 0, as pi would have.
"""
import json
import os
from pathlib import Path
import selectors
import signal
import sqlite3
import subprocess
import sys
import time

# The event that states the adapter ended a settled session. tillr-run copies it into
# the run record as `ending_exception`; the run stays an ordinary exit.
ENDED_EVENT = "tillr_harness_ended"
# The documented SIGTERM shutdown disposes the runtime first, which can await MCP
# servers. This bound only chooses how an ALREADY-ENDED session's process is removed
# (a second SIGTERM, which pi turns into an immediate exit, then SIGKILL); it never
# decides that work is over. TILLR_HARNESS_EXIT_BOUND_SECONDS overrides it.
DEFAULT_EXIT_BOUND = 120.0
# How often a settled session's journal is re-read while it still owes work. Not a
# limit: a session that owes a wake simply keeps waiting for its next `agent_start`.
OWED_RECHECK_SECONDS = 1.0
# How long after `agent_settled` the journal is first read. A healthy print mode
# disposes and exits by itself in this window, and that exit is ordinary: only a pi
# still present afterwards is ended here and recorded as an exception. Whichever
# happens, the run ends answered; the grace only decides who removes the process.
# TILLR_SETTLED_EXIT_GRACE_SECONDS overrides it.
DEFAULT_SETTLED_GRACE = 30.0

JOURNAL_ENV = "PI_BACKGROUND_TASK_JOURNAL"
JOURNAL_DISABLED = {"0", "false", "off", "no", "none", "disabled"}


def journal_path(env):
    """pi-background-tasks' own resolution (journal.ts resolveJournalPath)."""
    configured = (env.get(JOURNAL_ENV) or "").strip()
    if configured.lower() in JOURNAL_DISABLED:
        return None
    if configured:
        return os.path.abspath(configured)
    state = (env.get("XDG_STATE_HOME") or "").strip() or os.path.join(
        os.path.expanduser("~"), ".local", "state")
    return os.path.join(state, "pi-background-tasks", "journal.sqlite")


def owed_work(path, pid, since_ms):
    """Whether the session in process `pid` still owes a wake turn.

    Returns True (owed), False (nothing owed) or None (cannot tell). Only a
    wake-policy task takes a session hold, so only it can owe a turn: one that has
    not ended, or one that ended for a wake and whose completion the session has
    not observed. A stopped task (wake_requested 0) and a delivery that failed to
    enqueue owe nothing. No journal, no instance row for this process since it
    started, a disabled journal or an unreadable one is None, never permission.
    """
    if not path or not os.path.exists(path):
        return None
    try:
        db = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=1)
    except sqlite3.Error:
        return None
    try:
        instances = db.execute(
            "SELECT instance_id, disabled_at FROM instances WHERE process_id=? AND started_at>=?",
            (pid, since_ms)).fetchall()
        if not instances or any(disabled is not None for _, disabled in instances):
            return None
        marks = ",".join("?" * len(instances))
        ids = [instance for instance, _ in instances]
        row = db.execute(f"""
            SELECT COUNT(*) FROM tasks t
            WHERE t.started_by_instance IN ({marks}) AND t.completion_policy='wake' AND (
              t.ended_at IS NULL OR NOT EXISTS (
                SELECT 1 FROM deliveries d WHERE d.task_key=t.task_key AND (
                  d.wake_requested=0 OR EXISTS (
                    SELECT 1 FROM delivery_events e WHERE e.delivery_key=d.delivery_key
                    AND e.event IN ('observed','enqueue-failed')))))""", ids).fetchone()
        return row[0] > 0
    except sqlite3.Error:
        return None
    finally:
        db.close()


def seconds(env, name, default):
    try:
        return max(0.0, float(env.get(name, default)))
    except ValueError:
        return default


def end_settled(child, bound):
    """End a settled pi with its documented shutdown; return what was done."""
    actions = []
    for sig in (signal.SIGTERM, signal.SIGTERM, signal.SIGKILL):
        try:
            child.send_signal(sig)
        except ProcessLookupError:
            break
        actions.append(f"{signal.Signals(sig).name} to pi {child.pid}")
        try:
            child.wait(timeout=bound if sig != signal.SIGKILL else None)
            break
        except subprocess.TimeoutExpired:
            continue
    return actions


def main():
    request = Path(sys.argv[1])
    launched_ms = int(time.time() * 1000) - 1000
    journal = journal_path(os.environ)
    grace = seconds(os.environ, "TILLR_SETTLED_EXIT_GRACE_SECONDS", DEFAULT_SETTLED_GRACE)
    bound = seconds(os.environ, "TILLR_HARNESS_EXIT_BOUND_SECONDS", DEFAULT_EXIT_BOUND)
    # Inherit stdin/stderr and the runner's process group. Forward stdout byte for
    # byte, but wait for the session header: print mode emits it AFTER installing
    # SIGUSR1. Sending during startup could otherwise lose the request to Node's
    # debugger handler. No header or ignored signal is bounded by the runner.
    child = subprocess.Popen(sys.argv[2:], stdout=subprocess.PIPE)
    ready = False
    sent = False
    pending = bytearray()
    oversized = False
    # The first bytes of the current stream line: enough to read its event type.
    # Only a top-level event begins a line; model text is JSON-escaped inside one.
    head = bytearray()
    settled = False
    next_check = 0.0
    ended = None
    with selectors.DefaultSelector() as selector:
        selector.register(child.stdout, selectors.EVENT_READ)
        while True:
            # Observe exit BEFORE checking the pipe. Output can arrive between
            # an empty select and a later poll; that ordering would lose it.
            exited = child.poll() is not None
            events = selector.select(timeout=0 if exited else 0.1)
            if not events and exited:
                break
            for key, _ in events:
                data = os.read(key.fileobj.fileno(), 65536)
                if not data:
                    selector.unregister(key.fileobj)
                    continue
                sys.stdout.buffer.write(data)
                sys.stdout.buffer.flush()
                for part in data.splitlines(keepends=True):
                    if len(head) < 64:
                        head.extend(part[:64 - len(head)])
                    if part.endswith(b"\n"):
                        if head.startswith(b'{"type":"agent_settled"'):
                            settled, next_check = True, time.monotonic() + grace
                        elif head.startswith(b'{"type":"agent_start"'):
                            settled = False
                        head.clear()
                if not ready:
                    # Startup diagnostics are not readiness. Bound memory even if
                    # an extension writes a huge line before the session header.
                    for part in data.splitlines(keepends=True):
                        if len(pending) + len(part) > 65536:
                            oversized = True
                            pending.clear()
                        if not oversized:
                            pending.extend(part)
                        if part.endswith(b"\n"):
                            if not oversized:
                                try:
                                    header = json.loads(pending)
                                    ready = isinstance(header, dict) and header.get("type") == "session"
                                except (ValueError, UnicodeError):
                                    pass
                            pending.clear()
                            oversized = False
                            if ready:
                                break
            if ready and not sent and request.exists() and child.poll() is None:
                try:
                    child.send_signal(signal.SIGUSR1)
                except ProcessLookupError:
                    pass  # A natural exit raced the request; wait still reaps it.
                sent = True
            if settled and not sent and child.poll() is None and time.monotonic() >= next_check:
                next_check = time.monotonic() + OWED_RECHECK_SECONDS
                if owed_work(journal, child.pid, launched_ms) is False:
                    ended = end_settled(child, bound)
                    settled = False
    if ended is not None:
        # Forward what pi flushed during its shutdown before the closing event. A
        # helper that inherited the pipe can hold it open, so read only what is there.
        with selectors.DefaultSelector() as rest:
            rest.register(child.stdout, selectors.EVENT_READ)
            while rest.select(timeout=0):
                chunk = os.read(child.stdout.fileno(), 65536)
                if not chunk:
                    break
                sys.stdout.buffer.write(chunk)
                if chunk.endswith(b"\n"):
                    head.clear()
                elif chunk:
                    head[:] = b"x"
    child.stdout.close()
    code = child.wait()
    code = code if code >= 0 else 128 - code
    if ended is not None:
        line = json.dumps({
            "type": ENDED_EVENT,
            "after": "agent_settled",
            "reason": "pi did not exit after its session settled with no background work owed",
            "actions": ended,
            "harness_exit": code,
        })
        sys.stdout.buffer.write((("\n" if head else "") + line + "\n").encode())
        sys.stdout.buffer.flush()
        return 0
    return code


if __name__ == "__main__":
    sys.exit(main())
