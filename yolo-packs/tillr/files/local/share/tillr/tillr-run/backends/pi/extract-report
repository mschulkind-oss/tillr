#!/usr/bin/env python3
"""The Pi dialect: the harness's own event stream, one JSON event per line.

Pi streams agent events (`message_start`, `message_update`, `message_end`,
`tool_execution_*`, `agent_end`) and, in `--mode json`, serializes each as one line. The
assistant's text reaches the stream three ways, and the dialect reads them in this
order so a truncated stream still yields what it can:

  1. `message_update` carries `assistantMessageEvent`, and a `text_delta` there carries
     `delta` — the streaming form, and the only one a mid-run truncation leaves intact;
  2. `agent_end` carries `messages`, the turn's whole message list — the settled form;
  3. a message snapshot on any event, `message.content` blocks of `type: "text"` —
     the session-file form, which the same extractor reads when handed a session log.

`message_start` and `message_update` carry a *snapshot* of the message so far, not a
delta, so snapshots are keyed and replaced rather than appended: appending them would
repeat every token once per update.

`--mode json` writes the session file's own header as the stream's first line, so the
session id is there: `{"type": "session", "version": 3, "id": "…"}`. That is the event
this dialect reads; the `sessionId`/`session_id`/`session.id` spellings are kept because
a session *file* handed in as a stream carries the same header plus the rest.

Pi has no `--output-schema`, so the `RESULT:` footer arrives as the last line of the
assistant's text, exactly as the brief asks for.
"""

import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

import report  # noqa: E402  (the shared report shape lives one directory up)
import usage as measurements  # noqa: E402

# The counters a `turn_end` usage block can carry, and the one total pi sometimes adds
# alongside them. A cache read is billed, so it counts toward the total.
USAGE_COUNTERS = ("input", "output", "cacheRead", "cacheWrite", "reasoning")


def _blocks_text(message):
    content = message.get("content")
    if not isinstance(content, list):
        return ""
    return "".join(
        block.get("text") or ""
        for block in content
        if isinstance(block, dict) and block.get("type") == "text"
    )


def _is_reasoning_only(message):
    if message is None:
        return False
    content = message.get("content")
    return (
        isinstance(content, list)
        and not _blocks_text(message).strip()
        and not any(isinstance(block, dict) and block.get("type") == "toolCall" for block in content)
    )


def _current_text(deltas, settled, snapshots):
    if deltas:
        return "".join(deltas)
    if settled:
        return "".join(settled)
    return "".join(snapshots.values())


def _is_prompt_message(message):
    if not isinstance(message, dict):
        return False
    role = message.get("role")
    if role == "user":
        return True
    if role == "custom":
        return message.get("customType") != "memory-context"
    return False


def dialect(stream_text, live_probe=False):
    records, unparseable = report.records(stream_text)
    deltas, snapshots, settled = [], {}, []
    last_assistant = None
    # After an agent_end that already carried a RESULT footer, pi's post-run threshold
    # compaction runs session_compact while isStreaming is still true. Extensions such as
    # @pify/memory call sendMessage({customType: "memory-context"}) without triggerTurn: false,
    # which steers the agent and starts an unprompted turn. Preserve the settled answer unless
    # a real prompt (or an overflow/retry compaction or parked call) supersedes it.
    last_result_ending = None
    post_compaction_candidate = None
    ended = None
    tokens, cost, saw_tokens, saw_cost = 0, 0.0, False, False
    session, first_at, last_at = None, None, None
    for record in records:
        for key in ("sessionId", "session_id"):
            if not session and isinstance(record.get(key), str):
                session = record[key]
        if not session and record.get("type") == "session":
            if isinstance(record.get("id"), str):
                session = record["id"]
        if not session and isinstance(record.get("session"), dict):
            if isinstance(record["session"].get("id"), str):
                session = record["session"]["id"]
        timestamp = record.get("timestamp")
        if isinstance(timestamp, (int, float)):
            micros = timestamp * 1000  # pi stamps milliseconds
            first_at = micros if first_at is None else first_at
            last_at = micros

        # Only `turn_end` is complete: `message_start`/`message_update` carry partial
        # usage, so summing them too would count one turn several times (the same rule
        # tools/tillr-trace's parser states).
        if record.get("type") == "turn_end":
            usage = (record.get("message") or {}).get("usage")
            if isinstance(usage, dict):
                total = usage.get("totalTokens")
                if not isinstance(total, (int, float)):
                    counted = [usage.get(key) for key in USAGE_COUNTERS]
                    counted = [value for value in counted if isinstance(value, (int, float))]
                    total = sum(counted) if counted else None
                if isinstance(total, (int, float)):
                    tokens += int(total)
                    saw_tokens = True
                billed = (usage.get("cost") or {}).get("total")
                if isinstance(billed, (int, float)):
                    cost += float(billed)
                    saw_cost = True

        if record.get("type") == "loop_detected":
            if record.get("action") == "recovered":
                continue
            # pi ended the session itself: the model kept repeating one identical call.
            # No footer is owed; the report says so rather than reading as truncated.
            args = json.dumps(record.get("args"), sort_keys=True, separators=(",", ":"), ensure_ascii=False)
            tool = record.get("toolName") or "(no tool)"
            ended = {"cause": "repeating-call",
                     "detail": f"pi ended the session because the model repeated one identical call "
                               f"{record.get('streak')} times in a row: {tool} {args}"}

        record_type = record.get("type")
        if record_type == "compaction_start":
            if record.get("reason") != "overflow" and last_result_ending is not None and post_compaction_candidate is None:
                post_compaction_candidate = last_result_ending
        elif record_type == "compaction_end":
            if record.get("willRetry") is True or record.get("reason") == "overflow":
                post_compaction_candidate = None
            elif last_result_ending is not None and post_compaction_candidate is None:
                post_compaction_candidate = last_result_ending
        elif record_type == "parked":
            post_compaction_candidate = None

        if post_compaction_candidate is not None:
            if record_type in ("message", "message_start", "message_end", "turn_end") and _is_prompt_message(record.get("message")):
                post_compaction_candidate = None
            elif record_type == "agent_end" and any(_is_prompt_message(m) for m in (record.get("messages") or [])):
                post_compaction_candidate = None

        update = record.get("assistantMessageEvent")
        if isinstance(update, dict) and update.get("type") == "text_delta":
            if isinstance(update.get("delta"), str):
                deltas.append(update["delta"])
        if record_type == "agent_end":
            for message in record.get("messages") or []:
                if isinstance(message, dict) and message.get("role") == "assistant":
                    last_assistant = message
                    settled.append(_blocks_text(message))
            if post_compaction_candidate is None:
                ending_text = _current_text(deltas, settled, snapshots)
                if not _is_reasoning_only(last_assistant) and report.footer_result(ending_text) is not None:
                    last_result_ending = (ending_text, last_assistant)
                else:
                    last_result_ending = None
        message = record.get("message")
        if isinstance(message, dict) and message.get("role") == "assistant":
            # A streaming snapshot may still receive text or a tool call.
            # Only a completed message can prove an empty turn.
            last_assistant = message if record_type in ("message", "message_end", "turn_end") else None
            key = message.get("id") or f"snapshot-{len(snapshots)}"
            snapshots[key] = _blocks_text(message)
    if post_compaction_candidate is not None:
        text, last_assistant = post_compaction_candidate
    else:
        text = _current_text(deltas, settled, snapshots)
    # A reasoning-only ending is not a report. In particular, neither prior
    # streaming deltas nor an earlier settled footer can finish this turn.
    if _is_reasoning_only(last_assistant):
        text = "[Pi's last assistant turn had no text or tool call.]\n"
    # The runner's idle watcher probes a live stream with an unknown exit code.
    # A stale agent_settled and a footer from an earlier turn do not authorize it
    # to end a parked call, even when the parked batch has emitted agent_end.
    if live_probe and any(record.get("type") == "parked" for record in records):
        text += "\n[land call parked; waiting for the harness to exit]"
    if ended is not None:
        text = (text + "\n" if text and not text.endswith("\n") else text) + f"[{ended['detail']}]\n"
    return {
        "ended": ended,
        "usage_details": measurements.details(records, "pi"),
        "text": text,
        "session": session,
        "started": report.micros_to_rfc3339(first_at),
        "finished": report.micros_to_rfc3339(last_at),
        "events": len(records),
        "unparseable": unparseable,
        "tokens": tokens if saw_tokens else None,
        "cost": cost if saw_cost else None,
        "lines": len(stream_text.splitlines()),
    }


if __name__ == "__main__":
    # readSpend passes unknown only while the process is alive; final extraction
    # supplies its exit status. Preserve the ordinary final report byte for byte.
    live = "--exit-code" in sys.argv and sys.argv.index("--exit-code") + 1 < len(sys.argv) and sys.argv[sys.argv.index("--exit-code") + 1] == "unknown"
    sys.exit(report.run(lambda stream: dialect(stream, live_probe=live)))
