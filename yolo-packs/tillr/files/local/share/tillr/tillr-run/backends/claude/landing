#!/usr/bin/env python3
"""The Claude Code delivery call: `mcp__tillr__land` and `mcp__tillr__obstacle`.

A Claude-backed worker ends its run with one tool call, as a pi worker does with `land`
(docs/design/tillr-landing-call.md section 7.1, D-LC12). Four pieces, one file:

  mcp            a stdio MCP server exposing `land` and `obstacle`. Its call handler only
                 ever runs on replay: it returns the staged gate answer as the call's result.
  pre-tool-use   the PreToolUse hook. It answers the checks a worker can fix at once
                 with `deny`, writes `landing-offer.json` and answers `defer` for a valid
                 ending call (the harness then exits with the call unanswered), and answers
                 `allow` when `landing-answer.json` names this call, so the MCP server
                 delivers the answer as the call's own result.
  stop           the Stop hook: a plain-text stop with no ending call is nudged once per
                 distinct (head, tree, message) state.
  held           whether a session transcript holds a deferred call that a promptless
                 `--resume` will replay: exit 0 held, 3 already resolved, 1 neither.
  prepare        writes the MCP and settings files `run-claude` passes to the harness.
  answer         splits `landing-answer.json` into the call id and the text.

The record formats are the ones pi's land.ts and obstacle.ts write, so the drain reads one
offer shape from both backends.
"""
import argparse
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import uuid

LAND = "mcp__tillr__land"
OBSTACLE = "mcp__tillr__obstacle"
SERVER_NAME = "tillr"
TAIL_WINDOW = 1 << 20  # the window Claude Code scans for a deferred-tool marker

OBSTACLE_REQUIRED = {
    "definition": ["CRITERIA", "EVIDENCE"],
    "trunk": ["CHECKS", "BASE"],
    "tooling": ["COMMAND", "EVIDENCE", "PATHS"],
    "seat": ["TRIED", "MISSING"],
    "owner": ["QUESTION"],
}
OBSTACLE_FIELDS = ["criteria", "evidence", "paths", "checks", "base", "command", "tried", "missing", "question"]

INSTRUCTIONS = (
    "`mcp__tillr__land` is the brief's `land` call and `mcp__tillr__obstacle` is its `obstacle` call. "
    "Call one of them by itself, never in a batch with another tool. The call returns at once when a "
    "check you can fix fails. Otherwise this session ends with the call open, and the gate's answer "
    "arrives later as that call's result."
)


class Refusal(Exception):
    pass


def read_record(path):
    try:
        with open(path, encoding="utf-8") as source:
            return json.load(source)
    except FileNotFoundError:
        return None


def blocks(row):
    message = row.get("message") if isinstance(row, dict) else None
    content = message.get("content") if isinstance(message, dict) else None
    return [b for b in content if isinstance(b, dict)] if isinstance(content, list) else []


def rows(path, tail=None):
    """The JSON rows of a session transcript; the last `tail` bytes when given."""
    with open(path, "rb") as source:
        if tail is not None:
            size = source.seek(0, os.SEEK_END)
            source.seek(max(0, size - tail))
            if size > tail:
                source.readline()  # a partial first line
        raw = source.read().decode("utf-8", "replace")
    for line in raw.splitlines():
        try:
            row = json.loads(line)
        except ValueError:
            continue
        if isinstance(row, dict):
            yield row


def answered(transcript, call_id):
    """Whether the transcript already carries a tool_result for the call."""
    if not transcript or not call_id:
        return False
    try:
        return any(b.get("type") == "tool_result" and b.get("tool_use_id") == call_id
                   for row in rows(transcript) for b in blocks(row))
    except OSError:
        return False


def git(cwd, *args):
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, check=True).stdout


def head_of(cwd):
    return git(cwd, "rev-parse", "--verify", "HEAD").strip()


def dirty_paths(cwd):
    seen, paths = set(), []
    for args in (
        ("diff", "--name-only", "--no-renames", "-z"),
        ("diff", "--cached", "--name-only", "--no-renames", "-z"),
        ("ls-files", "--others", "--exclude-standard", "-z"),
    ):
        for entry in git(cwd, *args).split("\0"):
            if entry and entry not in seen:
                seen.add(entry)
                paths.append(entry)
    return paths


def validate_obstacle(args):
    kind = args.get("kind", "").strip().lower() if isinstance(args.get("kind"), str) else ""
    required = OBSTACLE_REQUIRED.get(kind)
    if not required:
        raise Refusal(f"Invalid obstacle kind {json.dumps(args.get('kind', ''))}; expected one of {', '.join(sorted(OBSTACLE_REQUIRED))}.")
    fields, missing = {}, []
    for name in required:
        raw = args.get(name.lower())
        value = raw.strip() if isinstance(raw, str) else ""
        if value:
            fields[name] = value
        else:
            missing.append(name.lower())
    if missing:
        raise Refusal(f"The {kind} obstacle is missing required field(s): {', '.join(missing)}.")
    if kind == "tooling":
        entries = [p.strip("`*-") for p in fields["PATHS"].replace(",", " ").split()]
        entries = [p for p in entries if p]
        if not entries:
            raise Refusal(f"The {kind} obstacle is missing required field(s): paths.")
        for path in entries:
            if path.startswith("/") or path == ".." or path.startswith("../"):
                raise Refusal(f"The {kind} obstacle's paths must be repository-relative, and {path} is not.")
    return {"kind": kind, "fields": fields}


def write_offer(path, offer):
    temp = f"{path}.{uuid.uuid4()}"
    try:
        with open(temp, "x", encoding="utf-8") as out:
            os.fchmod(out.fileno(), 0o600)
            out.write(json.dumps(offer) + "\n")
        os.rename(temp, path)
    finally:
        try:
            os.unlink(temp)
        except FileNotFoundError:
            pass


def pre_tool_use(event, durable, base):
    """Return ("allow"|"defer"|"deny", reason)."""
    name, call_id = event.get("tool_name"), event.get("tool_use_id")
    cwd, transcript = event.get("cwd") or os.getcwd(), event.get("transcript_path") or ""
    ending = name in (LAND, OBSTACLE)
    answer = read_record(os.path.join(durable, "landing-answer.json"))
    if ending and answer is not None and answer.get("call_id") == call_id:
        return "allow", "delivering the gate's answer as this call's result"
    path = os.path.join(durable, "landing-offer.json")
    offer = read_record(path)
    if offer is not None:
        offered = offer.get("call_id")
        if ending and offered == call_id:
            return "defer", None  # replay of a call already parked
        if answered(transcript, offered):
            os.unlink(path)  # a call that has its result never parked
        else:
            return "deny", f"Another ending call is open: {offered}. Make no other tool call; this session is ending."
    if not ending:
        return "allow", None
    try:
        state = read_record(os.path.join(durable, "landing-state.json")) or {}
        for entry in state.get("open") or []:
            if entry.get("call_id") not in (call_id, None) and not answered(transcript, entry.get("call_id")):
                raise Refusal(f"Another ending call is open: {entry['call_id']}.")
        if any(entry.get("call_id") == call_id for entry in state.get("open") or []):
            return "defer", None
        if answer is not None and not answered(transcript, answer.get("call_id")):
            raise Refusal("The staged landing answer belongs to a different call.")
        tool_input = event.get("tool_input") or {}
        head = head_of(cwd)
        if name == LAND:
            if head == base:
                raise Refusal("There is no commit to offer: HEAD is still the staged base.")
            dirty = dirty_paths(cwd)
            if dirty:
                raise Refusal("Commit or remove these uncommitted paths:\n" + "\n".join(dirty))
            refusal = next((e for e in state.get("refused") or [] if e.get("commit") == head and e.get("report_only") is not True), None)
            if refusal:
                raise Refusal(f"This commit was already refused. A new commit is required.\n{refusal.get('answer', '')}")
            record = {"call_id": call_id, "commit": head, "base": base, "transcript": transcript}
        else:
            parsed = validate_obstacle(tool_input)
            if parsed["kind"] == "seat" and head == base and not dirty_paths(cwd):
                raise Refusal("A seat obstacle needs an attempt: make a change or commit first, then report what you tried.")
            record = {"call_id": call_id, "tool": "obstacle", "base": base, "obstacle": parsed, "transcript": transcript}
    except Refusal as refusal:
        return "deny", str(refusal)
    write_offer(path, record)
    return "defer", None


def allows_unchanged_piece():
    brief = os.environ.get("BOARD_DRAIN_BRIEF")
    if not brief:
        return False
    try:
        with open(brief, encoding="utf-8") as source:
            text = source.read()
    except OSError:
        return False
    text = re.split(r"^## Saved (?:idea|request) words \(verbatim; \d+ bytes\)$", text, maxsplit=1, flags=re.M)[0]
    # The staged node header supplies this line before any piece prompt.
    return bool(re.search(r"^## Workflow node\n\nRun only node .+ on the .+ seat; access: write\.\n"
                          r"An unchanged piece may finish without a commit\.$", text, re.M))


def stop(event, durable, base):
    """Return a block reason, or None to let the session stop."""
    pause = os.environ.get("TILLR_PAUSE_REQUEST")
    if pause and os.path.exists(pause):
        return None
    cwd = event.get("cwd") or os.getcwd()
    if os.path.exists(os.path.join(durable, "landing-offer.json")):
        return None
    text = ""
    transcript = event.get("transcript_path")
    if transcript:
        try:
            for row in rows(transcript):
                if row.get("type") == "assistant":
                    text = "".join(b.get("text", "") for b in blocks(row) if b.get("type") == "text") or text
        except OSError:
            pass
    allow_unchanged_piece = allows_unchanged_piece()
    try:
        head = head_of(cwd)
        status = git(cwd, "status", "--porcelain=v1", "--untracked-files=all")
        if allow_unchanged_piece and head == base and not status and text.rstrip().split("\n")[-1].strip() == "RESULT: done":
            return None
        state = "\0".join([head, status, git(cwd, "diff", "HEAD")])
    except subprocess.CalledProcessError:
        state = ""
    mark = os.path.join(durable, "stop-nudge")
    fingerprint = hashlib.sha256(f"{state}\0{text}".encode()).hexdigest()
    try:
        with open(mark, encoding="utf-8") as source:
            if source.read().strip() == fingerprint:
                return None
    except FileNotFoundError:
        pass
    with open(mark, "w", encoding="utf-8") as out:
        out.write(fingerprint + "\n")
    reason = ("You ended without calling `mcp__tillr__land` or `mcp__tillr__obstacle`. Call land "
              "when your commit is ready, or obstacle when an obstacle holds.")
    if allow_unchanged_piece:
        reason += " If the piece already holds at its unchanged, clean base, end with RESULT: done instead."
    return reason


def held(transcript, call_id):
    """0 when a promptless --resume will replay the call, 3 when its result is already saved."""
    if not call_id:
        return 1
    deferred = resolved = False
    for row in rows(transcript, TAIL_WINDOW):
        attachment = row.get("attachment")
        if isinstance(attachment, dict) and attachment.get("type") == "hook_deferred_tool" and attachment.get("toolUseID") == call_id:
            deferred, resolved = True, False
        for b in blocks(row):
            if b.get("type") == "tool_result" and b.get("tool_use_id") == call_id:
                resolved = True
    if resolved:
        return 3
    return 0 if deferred else 1


def load_settings_spec(spec):
    stripped = spec.strip()
    if stripped.startswith("{"):
        body = json.loads(stripped)
    else:
        with open(spec, encoding="utf-8") as source:
            body = json.load(source)
    if not isinstance(body, dict):
        raise ValueError("settings must be a JSON object")
    return body


def merge_settings(target, incoming):
    for key, value in incoming.items():
        if key == "hooks" and isinstance(value, dict) and isinstance(target.get("hooks"), dict):
            for event_name, entries in value.items():
                if isinstance(entries, list):
                    target["hooks"].setdefault(event_name, []).extend(entries)
                else:
                    target["hooks"][event_name] = entries
        elif isinstance(value, dict) and isinstance(target.get(key), dict):
            merge_settings(target[key], value)
        else:
            target[key] = value


def prepare(durable, base, base_settings, extra_settings_file=""):
    me = os.path.abspath(__file__)
    py = sys.executable or "python3"
    launch = lambda *words: " ".join(shlex.quote(w) for w in (py, me, *words))  # noqa: E731
    args = ["--durable", durable, "--base", base]
    mcp = {"mcpServers": {SERVER_NAME: {"type": "stdio", "command": py, "args": [me, "mcp", "--durable", durable]}}}
    settings = {}
    if base_settings:
        merge_settings(settings, load_settings_spec(base_settings))
    if extra_settings_file:
        with open(extra_settings_file, "rb") as source:
            for raw in source.read().split(b"\0"):
                if raw:
                    merge_settings(settings, load_settings_spec(raw.decode("utf-8")))
    hooks = settings.setdefault("hooks", {})
    hooks.setdefault("PreToolUse", []).append({"matcher": "*", "hooks": [{"type": "command", "command": launch("pre-tool-use", *args)}]})
    hooks.setdefault("Stop", []).append({"hooks": [{"type": "command", "command": launch("stop", *args)}]})
    paths = {}
    for name, body in (("claude-mcp.json", mcp), ("claude-settings.json", settings)):
        paths[name] = os.path.join(durable, name)
        with open(paths[name], "w", encoding="utf-8") as out:
            json.dump(body, out)
            out.write("\n")
    return paths


def tools():
    return [
        {"name": "land", "description": "Offer the commit at HEAD for landing, ending this run.",
         "inputSchema": {"type": "object", "properties": {}, "additionalProperties": False}},
        {"name": "obstacle", "description": "Report an obstacle that prevents finishing this run, ending the run until resolved. Provide kind and that kind's required fields.",
         "inputSchema": {"type": "object", "required": ["kind"], "properties": dict(
             {"kind": {"type": "string", "enum": sorted(OBSTACLE_REQUIRED)}}, **{f: {"type": "string"} for f in OBSTACLE_FIELDS}), "additionalProperties": False}},
    ]


def call_tool(params, durable):
    call_id = ((params.get("_meta") or {}).get("claudecode/toolUseId"))
    answer = read_record(os.path.join(durable, "landing-answer.json"))
    if answer is not None and call_id and answer.get("call_id") == call_id and isinstance(answer.get("text"), str) and answer["text"].strip():
        return {"content": [{"type": "text", "text": answer["text"]}], "isError": True}
    # The harness ran the call without a deferral, or without an answer: nothing was offered.
    path = os.path.join(durable, "landing-offer.json")
    offer = read_record(path)
    if offer is not None and (call_id is None or offer.get("call_id") == call_id):
        os.unlink(path)
    return {"content": [{"type": "text", "text": "This call was not parked. Call mcp__tillr__land or mcp__tillr__obstacle by itself, with no other tool call in the same message."}], "isError": True}


def serve(durable):
    for line in sys.stdin:
        try:
            message = json.loads(line)
        except ValueError:
            continue
        method, ident = message.get("method"), message.get("id")
        if ident is None:
            continue
        if method == "initialize":
            result = {"protocolVersion": (message.get("params") or {}).get("protocolVersion", "2024-11-05"),
                      "capabilities": {"tools": {}}, "serverInfo": {"name": SERVER_NAME, "version": "1"}, "instructions": INSTRUCTIONS}
        elif method == "tools/list":
            result = {"tools": tools()}
        elif method == "tools/call":
            result = call_tool(message.get("params") or {}, durable)
        elif method == "ping":
            result = {}
        else:
            sys.stdout.write(json.dumps({"jsonrpc": "2.0", "id": ident, "error": {"code": -32601, "message": "method not found"}}) + "\n")
            sys.stdout.flush()
            continue
        sys.stdout.write(json.dumps({"jsonrpc": "2.0", "id": ident, "result": result}) + "\n")
        sys.stdout.flush()


def main(argv):
    parser = argparse.ArgumentParser(prog="landing")
    parser.add_argument("command", choices=["mcp", "pre-tool-use", "stop", "held", "prepare", "answer"])
    parser.add_argument("rest", nargs="*")
    parser.add_argument("--durable", default=os.environ.get("YOLO_DURABLE_DIR", ""))
    parser.add_argument("--base", default=os.environ.get("TILLR_GOAL_BASE", ""))
    parser.add_argument("--settings-json", default="")
    parser.add_argument("--extra-settings-file", default="")
    options = parser.parse_args(argv)
    if options.command == "held":
        try:
            return held(options.rest[0], options.rest[1])
        except (OSError, IndexError):
            return 1
    if options.command == "answer":  # answer ANSWER-FILE ID-OUT TEXT-OUT
        try:
            with open(options.rest[0], encoding="utf-8") as source:
                answer = json.load(source)
            call, text = answer["call_id"], answer["text"]
            if not isinstance(call, str) or not call or not isinstance(text, str) or not text:
                return 1
            for path, body in ((options.rest[1], call), (options.rest[2], text)):
                with open(path, "w", encoding="utf-8") as out:
                    out.write(body)
        except (OSError, ValueError, TypeError, KeyError, IndexError):
            return 1
        return 0
    if not options.durable:
        print("landing: the run's scratch directory is not staged", file=sys.stderr)
        return 2
    if options.command == "mcp":
        serve(options.durable)
    elif options.command == "prepare":
        try:
            print(json.dumps(prepare(options.durable, options.base, options.settings_json, options.extra_settings_file)))
        except (OSError, ValueError) as exc:
            print(f"landing: invalid settings: {exc}", file=sys.stderr)
            return 2
    elif options.command == "pre-tool-use":
        decision, reason = pre_tool_use(json.load(sys.stdin), options.durable, options.base)
        if decision == "allow" and reason is None:
            return 0  # not an ending call: no opinion
        out = {"hookEventName": "PreToolUse", "permissionDecision": decision}
        if reason:
            out["permissionDecisionReason"] = reason
        print(json.dumps({"hookSpecificOutput": out}))
    else:
        reason = stop(json.load(sys.stdin), options.durable, options.base)
        if reason:
            print(json.dumps({"decision": "block", "reason": reason}))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
