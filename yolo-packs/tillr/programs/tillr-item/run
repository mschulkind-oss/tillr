#!/bin/sh
# tillr-item -- the launcher the tillr pack puts on PATH at ~/.local/bin/tillr-item.
#
# The toolset itself is a `files` contribution of this pack, delivered whole to
# ~/.local/share/tillr: Go source, never a compiled artifact. This launcher builds one
# binary from that tree, once per source digest, into
# ${XDG_CACHE_HOME:-$HOME/.cache}/tillr/bin/<name>-<digest>, and execs that copy; a warm
# cache runs no Go command at all.
#
# The launchers share one body: `tillr` is the umbrella dispatcher and is built from
# module `tillr-cli`; every other name is built from the module of the same name. Only
# the two assignments below differ between them, and `just pack-sync-test` refuses a
# copy that has drifted.
#
# It must not change directory. A store is named relative to the caller's directory
# (`--store .tillr` and the like), so `exec` is the whole contract: same cwd, same
# arguments, no wrapper behavior. A `cd` here would resolve every caller's store against
# the wrong repository.
set -eu

bin=tillr-item
mod=tillr-item

root=${HOME:?$bin: HOME is unset}/.local/share/tillr
TILLR_INSTALL_ROOT=$root
export TILLR_INSTALL_ROOT
cache=${XDG_CACHE_HOME:-$HOME/.cache}/tillr/bin

if command -v sha256sum >/dev/null 2>&1; then
	sha256() { sha256sum | cut -d' ' -f1; }
else
	sha256() { shasum -a 256 | cut -d' ' -f1; }
fi

# Keyed by the tree's own path, so a checkout's build and the delivered pack's build
# never exec each other's binary.
current=$cache/current-$bin-$(printf %s "$root" | sha256 | cut -c1-16)

# THE FAST PATH. `current` names the binary the last build produced, and any source newer
# than it means the tree moved on. A warm cache therefore costs one `stat` per source file
# and no Go command at all; the digest below is only computed when that check says the
# tree changed, or when there is no binary to run.
#
# The walk covers the WHOLE tree, not just this binary's module: `tillr-drain` replaces
# ../tillr-item and ../tillr-run as well as ../tillr, so a per-module walk would leave its
# cached binary stale after an edit to a module it links.
newer() {
	for entry in "$1"/*; do
		[ -e "$entry" ] || continue
		if [ -d "$entry" ]; then
			case ${entry##*/} in
			node_modules | dist) continue ;;
			esac
			newer "$entry" && return 0
		else
			case ${entry##*/} in
			*_test.go) ;;
			*.go | *.toml | *.json | go.mod | go.sum) [ "$entry" -nt "$current" ] && return 0 ;;
			esac
			if [ "$mod" = tillr-view ]; then
				case $entry in
				"$root/tillr-view/web/tests/"*) ;;
				"$root/tillr-view/web/"*)
					case ${entry##*/} in
					*.ts | *.tsx | *.js | *.jsx | *.css | *.html | package.json | package-lock.json)
						[ "$entry" -nt "$current" ] && return 0
						;;
					esac
					;;
				esac
			fi
		fi
	done
	return 1
}

# A long-running program restarts onto a new build by asking its launcher, the one stable
# entry point, which binary is current: TILLR_LAUNCHER names this launcher in the
# program's environment, and TILLR_LAUNCHER_RESOLVE=1 makes it print that binary's path
# instead of running it. The cached executable a process runs from is immutable, so it can
# never name its own successor.
TILLR_LAUNCHER=$0
export TILLR_LAUNCHER
resolve() {
	if [ -n "${TILLR_LAUNCHER_RESOLVE:-}" ]; then
		echo "$1"
		exit 0
	fi
}

if [ -x "$current" ] && ! newer "$root"; then
	resolve "$current"
	exec "$current" "$@"
fi

# Glob recursion rather than `find`: a jail shims `find` to a refusal, and this launcher
# is what every caller in that jail runs. Test files are excluded because they never
# contribute to the built binary.
sources() {
	for dir in "$@"; do
		for entry in "$dir"/*; do
			[ -e "$entry" ] || continue
			if [ -d "$entry" ]; then
				case ${entry##*/} in
				node_modules | dist) continue ;;
				esac
				sources "$entry"
			else
				case ${entry##*/} in
				*_test.go) ;;
				*.go | *.toml | *.json | go.mod | go.sum) echo "$entry" ;;
				esac
			fi
		done
	done
}

digest=$(
	cd "$root" &&
		sources . |
		LC_ALL=C sort |
		xargs cat |
		sha256
)

built=$cache/$bin-$digest

web_newer() {
	for entry in "$1"/*; do
		[ -e "$entry" ] || continue
		if [ -d "$entry" ]; then
			case ${entry##*/} in
			node_modules | dist | tests) continue ;;
			esac
			web_newer "$entry" && return 0
		else
			case ${entry##*/} in
			*.ts | *.tsx | *.js | *.jsx | *.css | *.html | package.json | package-lock.json)
				[ "$entry" -nt "$web_built" ] && return 0
				;;
			esac
		fi
	done
	return 1
}

web_tags=
web_rebuilt=
obs_marker=$built.obs
if [ "$mod" = tillr-view ]; then
	web=$root/$mod/web
	web_built=$web/dist/index.html
	if [ -d "$web" ]; then
		if [ ! -f "$web_built" ] || web_newer "$web"; then
			if command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then
				web_platform=$(node -p 'process.platform + "-" + process.arch + (process.platform === "linux" ? (process.report.getReport().header.glibcVersionRuntime ? "-gnu" : "-musl") : "")' 2>/dev/null || true)
				stamp=$web/node_modules/.tillr-platform
				need_ci=
				if [ ! -d "$web/node_modules" ]; then
					need_ci=1
				elif [ "$web/package-lock.json" -nt "$web/node_modules/.package-lock.json" ]; then
					need_ci=1
				elif [ -n "$web_platform" ]; then
					if [ ! -f "$stamp" ] || [ "$(cat "$stamp")" != "$web_platform" ]; then
						need_ci=1
					fi
				fi
				if [ -n "$need_ci" ]; then
					if npm --prefix "$web" ci --no-audit --no-fund >&2; then
						[ -n "$web_platform" ] && printf '%s\n' "$web_platform" >"$stamp"
					else
						need_ci=failed
					fi
				fi
				if [ "$need_ci" != failed ] && npm --prefix "$web" run build >&2 && [ -f "$web_built" ]; then
					web_rebuilt=1
				fi
			elif [ ! -f "$web_built" ]; then
				echo "$bin: node and npm not found; building without observatory web UI (install node and npm to build it, or pass --web-dist)" >&2
			fi
		fi
		if [ -f "$web_built" ]; then
			web_tags="-tags observatory"
		elif command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then
			echo "$bin: observatory front-end build failed; building without observatory web UI (pass --web-dist to serve external assets)" >&2
		fi
	fi
	if [ -n "$web_tags" ] && [ ! -e "$obs_marker" ]; then
		web_rebuilt=1
	elif [ -z "$web_tags" ] && [ -e "$obs_marker" ]; then
		web_rebuilt=1
	fi
fi

if [ ! -x "$built" ] || [ -n "$web_rebuilt" ]; then
	command -v go >/dev/null 2>&1 || {
		echo "$bin: no cached binary for $digest and no go toolchain to build it" >&2
		exit 1
	}
	mkdir -p "$cache"
	tmp=$built.$$
	trap 'rm -f "$tmp"' EXIT HUP INT TERM
	(
		cd "$root/$mod"
		CGO_ENABLED=0 go build $web_tags -o "$tmp" .
	) || exit 1
	# Two callers racing a cold cache build the same source: whoever moves second finds
	# the winner's binary already in place and keeps it.
	if [ -x "$built" ] && [ -z "$web_rebuilt" ]; then
		rm -f "$tmp"
	else
		mv -f "$tmp" "$built"
		if [ "$mod" = tillr-view ]; then
			if [ -n "$web_tags" ]; then
				: >"$obs_marker"
			else
				rm -f "$obs_marker"
			fi
		fi
	fi
	trap - EXIT HUP INT TERM
fi

# The symlink is what the next invocation's fast path reads. It is written after the
# binary exists, so a reader never follows it to a half-built file.
ln -sfn "$built" "$current"
resolve "$built"
exec "$built" "$@"
