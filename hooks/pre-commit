#!/bin/sh
# tillr-hook: pre-commit -- keep foreign identities off main.
#
# Installed by just hooks-install. Plumbing, ref updates, detached commits and
# commits on other branches do not run this main-only guard; tillr checks the
# published trunk independently, including under the landing lock.
set -eu

hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
local_hook="$hook_dir/pre-commit.local"
if [ -e "$local_hook" ]; then
  "$local_hook" "$@" || exit $?
fi

if [ -n "${TILLR_PRE_COMMIT_BIN:-}" ]; then
  exec "$TILLR_PRE_COMMIT_BIN" "$@"
fi

top=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -n "$top" ] && [ -d "$top/tools/tillr/cmd/pre-commit-hook" ] && command -v go >/dev/null 2>&1; then
  exec go run -C "$top/tools/tillr" ./cmd/pre-commit-hook "$@"
fi

if command -v tillr-pre-commit >/dev/null 2>&1; then
  exec tillr-pre-commit "$@"
fi

printf 'pre-commit: tillr-pre-commit not found and tools/tillr/cmd/pre-commit-hook not in checkout; no commit made\n' >&2
exit 1
